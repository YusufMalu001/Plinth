enum QcCheckpointType {
  INCOMING_MATERIAL
  IN_PROCESS
  INTERMEDIATE
  ASSEMBLY
  PRE_FG
  FINAL_FG
}

enum InspectionResultStatus {
  PASS
  FAIL
  REWORK
  REJECT_SCRAP
  RE_INSPECTION
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

model InspectionResult {
  id                     String                    @id @default(uuid())
  inspectionNumber       String                    @unique
  checkpointType         QcCheckpointType
  qcRuleId               String?
  qcRule                 QcRule?                   @relation(fields: [qcRuleId], references: [id], onDelete: SetNull)
  batchId                String?
  batch                  DepartmentExecutionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  grnLineId              String?
  grnLine                GoodsReceiptLine?         @relation(fields: [grnLineId], references: [id], onDelete: Cascade)
  inspectorEmployeeId    String
  inspector              Employee                  @relation(fields: [inspectorEmployeeId], references: [id], onDelete: Restrict)
  sampledQuantity        Decimal                   @db.Decimal(18, 6)
  defectiveQuantity      Decimal                   @default(0) @db.Decimal(18, 6)
  status                 InspectionResultStatus
  reason                 String?
  findings               Json?
  evidenceAttachmentUrls String[]                  @default([])
  isOverride             Boolean                   @default(false)
  overrideReason         String?
  overrideByActorId      String?
  reinspectionOfId       String?
  reinspectionOf         InspectionResult?         @relation("InspectionReinspection", fields: [reinspectionOfId], references: [id], onDelete: SetNull)
  reinspections          InspectionResult[]        @relation("InspectionReinspection")
  correctiveActions      CorrectiveAction[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  LossEvent              LossEvent?
  assemblyBatches        AssemblyBatch[]           @relation("AssemblyBatchInspectionResult")
  fgReadyOutputs         FgReadyOutput[]           @relation("FgReadyOutputInspectionResult")

  @@index([checkpointType, status])
  @@index([batchId])
  @@index([grnLineId])
  @@index([inspectorEmployeeId])
  @@map("inspection_results")
}

model CorrectiveAction {
  id                  String                 @id @default(uuid())
  inspectionResultId  String
  inspectionResult    InspectionResult       @relation(fields: [inspectionResultId], references: [id], onDelete: Cascade)
  actionDescription   String
  assignedEmployeeId  String?
  assignedEmployee    Employee?              @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  targetReworkStageId String?
  status              CorrectiveActionStatus @default(OPEN)
  resolutionNotes     String?
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

