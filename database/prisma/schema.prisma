  updatedAt       DateTime @updatedAt

  lines  JournalLine[]
  outbox AccountingOutbox[]

  @@unique([entityId, voucherNumber])
  @@unique([entityId, sourceModule, sourceId, sourceRevision])
  @@index([entityId, accountingDate, status])
  @@map("journal_vouchers")
}

