  eventType            VendorScoringEventType
  component            String
  sourceEntityType     String
  sourceEntityId       String
  incidentId           String?
  debitNoteId          String?
  grnId                String?
  poId                 String?
  jobWorkOrderId       String?
  eligibleAmount       Decimal?                 @db.Decimal(18, 2)
  affectedInvoiceValue Decimal?                 @db.Decimal(18, 2)
  currency             String                   @default("INR")
  penaltyPoints        Decimal                  @db.Decimal(8, 4)
  scoreContribution    Decimal                  @db.Decimal(8, 4)
