// ==============================================================================
// MODULE 14 - JOB WORK / OUTSOURCED PROCESSING (Custody Ledger & Operations)
// ==============================================================================

enum JobWorkOrderStatus {
  DRAFT
  APPROVED
  ISSUED
  PARTIALLY_RETURNED
  FULLY_RETURNED
  RECONCILED
  CLOSED
  CANCELLED
}

enum JobWorkCustodyEntryType {
  RAW_MATERIAL_ISSUE
  PO_DEPOSIT_DEDUCTION
  RETURN_PROCESSING
  SCRAP_GENERATION
  WASTAGE_CONSUMPTION
  RETURN_DEFECT
  ADJUSTMENT
}

enum JobWorkReturnDisposition {
  FINISHED_GOODS
  RAW_MATERIAL_RETURN
  SCRAP
  DEFECTIVE_REWORK
}

enum JobWorkReconciliationStatus {
  PENDING
  RECONCILED
  DISCREPANCY_FLAGGED
  DEBIT_NOTE_INITIATED
  CLOSED
}

model JobWorkOrder {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique
  vendorId            String
  vendor              Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  targetQuantity      Float              @default(0)
  targetUomId         String?
  targetUom           UnitOfMeasure?     @relation(fields: [targetUomId], references: [id], onDelete: Restrict)
  rawMaterialInputQty Float              @default(0) // e.g. 4 tons dedicated for this PO production
  expectedScrapRate   Float              @default(0) // Percentage or estimated ratio
  status              JobWorkOrderStatus @default(DRAFT)
  deliveryLocationId  String?
  deliveryLocation    WarehouseLocation? @relation(fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  natureOfProcessing  String? // e.g. "Powder Coating", "Die Casting", "Machining & Assembly"
  specifications      String?
  createdById         String
  createdBy           User               @relation("JobWorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById        String?
  approvedBy          User?              @relation("JobWorkOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  closedById          String?
  closedBy            User?              @relation("JobWorkOrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt            DateTime?
  notes               String?
  evidenceAttachments Json? // Array of document/image metadata
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lines           JobWorkOrderLine[]
  challans        JobWorkMaterialIssue[]
  returns         JobWorkReceiptReturn[]
  reconciliations JobWorkReconciliation[]
  custodyLedgers  JobWorkCustodyLedger[]

  @@index([vendorId, status])
  @@index([createdAt])
  @@map("job_work_orders")
}

model JobWorkOrderLine {
  id                String        @id @default(uuid())
  jobWorkOrderId    String
  jobWorkOrder      JobWorkOrder  @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  materialId        String?
  material          Material?     @relation(fields: [materialId], references: [id], onDelete: Restrict)
  productId         String?
  product           Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  uomId             String
  uom               UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)
  requiredQuantity  Float
  allocatedQuantity Float         @default(0)
  issuedQuantity    Float         @default(0)
  returnedQuantity  Float         @default(0)
  consumedQuantity  Float         @default(0)
  scrapQuantity     Float         @default(0)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([jobWorkOrderId])
  @@map("job_work_order_lines")
}

model JobWorkMaterialIssue {
  id                 String            @id @default(uuid())
  challanNumber      String            @unique // e.g. JWC-2026-0001
  jobWorkOrderId     String?
  jobWorkOrder       JobWorkOrder?     @relation(fields: [jobWorkOrderId], references: [id], onDelete: SetNull)
  vendorId           String
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  dispatchLocationId String
  dispatchLocation   WarehouseLocation @relation(fields: [dispatchLocationId], references: [id], onDelete: Restrict)
  materialId         String?
  material           Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  productId          String?
  product            Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  uomId              String
  uom                UnitOfMeasure     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  quantity           Float // Quantity issued to vendor custody (e.g. 8 tons)
  vehicleNumber      String?
  transporterName    String?
  driverContact      String?
  idempotencyKey     String?           @unique
  issuedById         String
  issuedBy           User              @relation("JobWorkChallanIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedAt           DateTime          @default(now())
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  custodyLedgers JobWorkCustodyLedger[]

  @@index([vendorId, issuedAt])
  @@map("job_work_material_issues")
}

model JobWorkCustodyLedger {
  id              String                  @id @default(uuid())
  entryNumber     String                  @unique
  vendorId        String
  vendor          Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  jobWorkOrderId  String?
  jobWorkOrder    JobWorkOrder?           @relation(fields: [jobWorkOrderId], references: [id], onDelete: SetNull)
  materialIssueId String?
  materialIssue   JobWorkMaterialIssue?   @relation(fields: [materialIssueId], references: [id], onDelete: SetNull)
  materialId      String?
  material        Material?               @relation(fields: [materialId], references: [id], onDelete: Restrict)
  productId       String?
  product         Product?                @relation(fields: [productId], references: [id], onDelete: Restrict)
  uomId           String
  uom             UnitOfMeasure           @relation(fields: [uomId], references: [id], onDelete: Restrict)
  entryType       JobWorkCustodyEntryType
  direction       StockDirection // IN = into vendor custody, OUT = out of vendor custody / consumed
  quantity        Float
  runningBalance  Float // Total vendor-held balance after entry
  referenceType   String // "CHALLAN", "PO_ALLOCATION", "GRN_RECEIPT", "RECONCILIATION"
  referenceId     String?
  note            String?
  createdAt       DateTime                @default(now())

  @@index([vendorId, materialId, productId])
  @@index([createdAt])
  @@map("job_work_custody_ledgers")
}

model JobWorkReceiptReturn {
  id                  String                   @id @default(uuid())
  returnNumber        String                   @unique // e.g. JWR-2026-0001
  jobWorkOrderId      String?
  jobWorkOrder        JobWorkOrder?            @relation(fields: [jobWorkOrderId], references: [id], onDelete: SetNull)
  vendorId            String
  vendor              Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  goodsReceiptId      String?                  @unique
  goodsReceipt        GoodsReceiptNote?        @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  locationId          String
  location            WarehouseLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  disposition         JobWorkReturnDisposition @default(FINISHED_GOODS)
  productId           String?
  product             Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  materialId          String?
  material            Material?                @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uomId               String
  uom                 UnitOfMeasure            @relation(fields: [uomId], references: [id], onDelete: Restrict)
  expectedQuantity    Float // From PO / Expected output
  receivedQuantity    Float // Actually received at gate
  acceptedQuantity    Float // Accepted after QC/measurement
  shortQuantity       Float                    @default(0) // Shortfall from expected
  excessQuantity      Float                    @default(0)
  scrapQuantity       Float                    @default(0) // Returned scrap
  consumedRawMaterial Float                    @default(0) // Deducted from vendor custody
  receivedById        String
  receivedBy          User                     @relation("JobWorkReturnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt          DateTime                 @default(now())
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  reconciliations JobWorkReconciliation[]

  @@index([vendorId, receivedAt])
  @@map("job_work_receipt_returns")
}

model JobWorkReconciliation {
  id                    String                      @id @default(uuid())
  reconciliationNumber  String                      @unique // e.g. JREC-2026-0001
  jobWorkOrderId        String
  jobWorkOrder          JobWorkOrder                @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  returnId              String?
  returnReceipt         JobWorkReceiptReturn?       @relation(fields: [returnId], references: [id], onDelete: SetNull)
  debitNoteId           String?
  debitNote             DebitNote?                  @relation(fields: [debitNoteId], references: [id], onDelete: SetNull)
  status                JobWorkReconciliationStatus @default(PENDING)
  totalIssuedQty        Float                       @default(0)
  totalReturnedQty      Float                       @default(0)
  totalConsumedQty      Float                       @default(0)
  totalScrapQty         Float                       @default(0)
  shortageQty           Float                       @default(0)
  excessQty             Float                       @default(0)
  outstandingCustodyQty Float                       @default(0)
  financialImpactNotes  String? // V-014 accounting separation note
  reconciledById        String
  reconciledBy          User                        @relation("JobWorkReconciliationDoneBy", fields: [reconciledById], references: [id], onDelete: Restrict)
  reconciledAt          DateTime                    @default(now())
  reason                String?
  evidenceAttachments   Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([jobWorkOrderId, status])
  @@map("job_work_reconciliations")
}

