model SalesOrder {
  id                   String                        @id @default(uuid())
  orderNumber          String                        @unique
  channel              SalesOrderChannel
  channelId            String?
  customerId           String?
  warehouseLocationId  String?
  externalOrderId      String?
  status               SalesOrderStatus              @default(DRAFT)
  paymentStatus        SalesPaymentStatus            @default(PENDING)
  allocationStatus     SalesAllocationStatus         @default(NOT_STARTED)
  accountingStatus     SalesAccountingStatus         @default(NOT_ELIGIBLE)
  currency             String                        @default("INR")
  subtotal             Decimal                       @default(0) @db.Decimal(18, 2)
  discountTotal        Decimal                       @default(0) @db.Decimal(18, 2)
  taxTotal             Decimal                       @default(0) @db.Decimal(18, 2)
  chargeTotal          Decimal                       @default(0) @db.Decimal(18, 2)
  grandTotal           Decimal                       @default(0) @db.Decimal(18, 2)
  orderedAt            DateTime                      @default(now())
  promisedAt           DateTime?
  confirmedAt          DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  notes                String?
  idempotencyKey       String?                       @unique
  createdByActorId     String
  approvedByActorId    String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  lines                SalesOrderLine[]
  addresses            SalesOrderAddress[]
  charges              SalesOrderCharge[]
  taxes                SalesOrderTax[]
  payments             SalesOrderPayment[]
  approvals            SalesOrderApproval[]
  statusHistory        SalesOrderStatusHistory[]
  externalReferences   SalesOrderExternalReference[]
  exceptions           SalesOrderException[]
  allocations          SalesOrderAllocation[]
  fulfillments         SalesFulfillment[]
  shipments            SalesShipment[]
  creditAuthorizations SalesCreditAuthorization[]
  financialReturns     SalesFinancialReturn[]
  dispatchDocuments    SalesDispatchDocument[]

  @@index([status, updatedAt])
  @@index([channel, orderedAt])
  @@index([customerId, orderedAt])
  @@index([externalOrderId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                   String                     @id @default(uuid())
  salesOrderId         String
  productId            String
  productVariantId     String?
  sku                  String
  description          String
  uomId                String
  orderedQuantity      Decimal                    @db.Decimal(18, 6)
  allocatedQuantity    Decimal                    @default(0) @db.Decimal(18, 6)
  pickedQuantity       Decimal                    @default(0) @db.Decimal(18, 6)
  packedQuantity       Decimal                    @default(0) @db.Decimal(18, 6)
  shippedQuantity      Decimal                    @default(0) @db.Decimal(18, 6)
  returnedQuantity     Decimal                    @default(0) @db.Decimal(18, 6)
  cancelledQuantity    Decimal                    @default(0) @db.Decimal(18, 6)
  unitPrice            Decimal                    @db.Decimal(18, 2)
  discountAmount       Decimal                    @default(0) @db.Decimal(18, 2)
  taxRate              Decimal                    @default(0) @db.Decimal(5, 2)
  taxAmount            Decimal                    @default(0) @db.Decimal(18, 2)
  lineTotal            Decimal                    @db.Decimal(18, 2)
  status               SalesOrderLineStatus       @default(OPEN)
  promisedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  salesOrder           SalesOrder                 @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  allocations          SalesOrderAllocation[]
  pickItems            SalesPickItem[]
  packageItems         SalesPackageItem[]
  shipmentLines        SalesShipmentLine[]
  financialReturnLines SalesFinancialReturnLine[]

  @@index([salesOrderId])
  @@index([productId, status])
  @@map("sales_order_lines")
}

model SalesOrderAddress {
  id           String     @id @default(uuid())
  salesOrderId String
  kind         String
  name         String?
  phone        String?
  line1        String
  line2        String?
  city         String
  state        String
  postalCode   String
  country      String     @default("IN")
  taxNumber    String?
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, kind])
  @@map("sales_order_addresses")
}

model SalesOrderCharge {
  id           String     @id @default(uuid())
  salesOrderId String
  code         String
  label        String
  amount       Decimal    @db.Decimal(18, 2)
  taxAmount    Decimal    @default(0) @db.Decimal(18, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@map("sales_order_charges")
}

model SalesOrderTax {
  id            String     @id @default(uuid())
  salesOrderId  String
  code          String
  rate          Decimal    @db.Decimal(5, 2)
  taxableAmount Decimal    @db.Decimal(18, 2)
  amount        Decimal    @db.Decimal(18, 2)
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@map("sales_order_taxes")
}

model SalesOrderPayment {
  id            String             @id @default(uuid())
  salesOrderId  String
  idempotencyKey String?           @unique
  payloadHash    String?
  method        String
  provider      String?
  reference     String?
  amount        Decimal            @db.Decimal(18, 2)
  status        SalesPaymentStatus @default(PENDING)
  paidAt        DateTime?
  failureReason String?
  salesOrder    SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, status])
  @@map("sales_order_payments")
}

model SalesOrderApproval {
  id           String                @id @default(uuid())
  salesOrderId String
  actorId      String
  decision     SalesApprovalDecision
  reason       String?
  createdAt    DateTime              @default(now())
  salesOrder   SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, createdAt])
  @@map("sales_order_approvals")
}

model SalesOrderStatusHistory {
  id           String     @id @default(uuid())
  salesOrderId String
  fromStatus   String?
  toStatus     String
  actorId      String
  reason       String?
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, createdAt])
  @@map("sales_order_status_history")
}

model SalesOrderExternalReference {
  id           String            @id @default(uuid())
  salesOrderId String
  channel      SalesOrderChannel
  externalId   String
  payload      Json?
  createdAt    DateTime          @default(now())
  salesOrder   SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([salesOrderId])
  @@map("sales_order_external_references")
