}

model TransmissionLog {
  id        String        @id @default(uuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  method    String        @default("MANUAL")
  actorId   String
  actor     User          @relation("TransmissionActor", fields: [actorId], references: [id], onDelete: Restrict)
