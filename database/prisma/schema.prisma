enum TransactionSourceType {
  PURCHASE_ORDER
  SALES_INVOICE
  DEBIT_NOTE
  JOB_WORK
  RETURN
  INVENTORY_COGS
}

enum IntegrationJobStatus {
  QUEUED
  PROCESSING
  EXPORTED
  FAILED
  COMPLETED
  CANCELLED
}

enum IntegrationJobItemStatus {
  ELIGIBLE
  QUEUED
  EXPORTED
  SENT
  ACKNOWLEDGED
  RECONCILED
  FAILED
  INVESTIGATED
  CORRECTED
  RETRIED
  REJECTED
  HELD
}

enum InternalReconciliationStatus {
  INTERNALLY_CONSISTENT
  VARIANCE_FLAGGED
}

model MappingConfiguration {
  id            String                @id @default(uuid())
  sourceType    TransactionSourceType
  version       Int                   @default(1)
  status        LifecycleStatus       @default(DRAFT)
  fieldMapping  Json
  effectiveFrom DateTime?
  approvedById  String?
  approvedBy    User?                 @relation("MappingConfigApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  createdById   String
  createdBy     User                  @relation("MappingConfigCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  jobItems      IntegrationJobItem[]

  @@unique([sourceType, version])
  @@index([sourceType, status])
  @@map("mapping_configurations")
}

model IntegrationJob {
  id            String                @id @default(uuid())
  jobCode       String                @unique
  sourceType    TransactionSourceType
  status        IntegrationJobStatus  @default(QUEUED)
  totalItems    Int                   @default(0)
  successCount  Int                   @default(0)
  failureCount  Int                   @default(0)
  batchFileRef  String?
  startedAt     DateTime?
  completedAt   DateTime?
  triggeredById String
  triggeredBy   User                  @relation("IntegrationJobTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         IntegrationJobItem[]

  @@index([sourceType, status])
  @@map("integration_jobs")
}

model IntegrationJobItem {
  id                   String                   @id @default(uuid())
  jobId                String
  job                  IntegrationJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceType           TransactionSourceType
  sourceId             String
  mappingConfigId      String
  mappingConfiguration MappingConfiguration     @relation(fields: [mappingConfigId], references: [id], onDelete: Restrict)
  status               IntegrationJobItemStatus @default(QUEUED)
  amount               Decimal                  @default(0) @db.Decimal(18, 2)
  currency             String                   @default("INR")
  payloadFingerprint   String                   @unique
  externalReference    String?
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  acknowledgedBy       User?                    @relation("JobItemAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  errorMessage         String?
  retryCount           Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  reconciliationRecord ReconciliationRecord?

  @@index([jobId, status])
  @@index([sourceType, sourceId])
  @@map("integration_job_items")
}

model ReconciliationRecord {
  id               String                       @id @default(uuid())
  jobItemId        String                       @unique
  jobItem          IntegrationJobItem           @relation(fields: [jobItemId], references: [id], onDelete: Cascade)
  internalAmount   Decimal                      @db.Decimal(18, 2)
  externalAmount   Decimal?                     @db.Decimal(18, 2)
  status           InternalReconciliationStatus @default(INTERNALLY_CONSISTENT)
  investigatedById String?
  investigatedBy   User?                        @relation("ReconciliationInvestigatedBy", fields: [investigatedById], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  reconciledAt     DateTime                     @default(now())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([status])
  @@map("reconciliation_records")
}

