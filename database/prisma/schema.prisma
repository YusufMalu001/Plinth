  @@unique([billId, lineNumber])
  @@index([poLineId])
  @@index([grnLineId])
  @@map("purchase_bill_lines")
}

enum ExpenseCategory {
  TRANSPORTATION
  ELECTRICIAN_MAINTENANCE
  LABOUR_WAGES
  WAREHOUSE_OPERATIONS
  UTILITIES_ELECTRICITY
  OFFICE_SUPPLIES
  FUEL_CONVEYANCE
  TEA_REFRESHMENTS
  FREIGHT_COURIER
  PROFESSIONAL_LEGAL
  MISCELLANEOUS
}

enum ExpensePaymentStatus {
  PAID
  PENDING
}

enum ExpensePaymentMode {
  CASH
  PETTY_CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

model MiscellaneousExpense {
  id                   String               @id @default(uuid())
  expenseNumber        String               @unique
  entityId             String
  entity               AccountingEntity     @relation(fields: [entityId], references: [id], onDelete: Restrict)
  category             ExpenseCategory
  title                String
  description          String?
  amount               Decimal              @db.Decimal(18, 2)
  taxAmount            Decimal              @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal              @db.Decimal(18, 2)
  expenseDate          DateTime             @db.Date
  payeeName            String
  payeeContact         String?
  paymentStatus        ExpensePaymentStatus @default(PAID)
  paymentMode          ExpensePaymentMode   @default(CASH)
  referenceNumber      String?
  paidThroughAccountId String?
  paidThroughAccount   LedgerAccount?       @relation("ExpensePaidThroughAccount", fields: [paidThroughAccountId], references: [id], onDelete: Restrict)
  expenseAccountId     String?
  expenseAccount       LedgerAccount?       @relation("ExpenseDebitAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)

  receiptUrl           String?              @db.Text
  receiptFileName      String?
  receiptFileType      String?
  receiptFileSize      Int?

  status               String               @default("RECORDED")
  journalVoucherId     String?
  notes                String?
  createdById          String
  createdBy            User                 @relation("UserExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([entityId, expenseDate])
  @@index([category, paymentStatus])
  @@map("miscellaneous_expenses")
}
