model MaterialIssueLine {
  id                 String   @id @default(uuid())
  materialIssueId    String
  bomLineId          String?
  materialId         String?
  componentProductId String?
  uomId              String
  requiredQuantity   Float
  issuedQuantity     Float    @default(0)
  shortageQuantity   Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  materialIssue           MaterialIssue            @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  bomLine                 BomLine?                 @relation(fields: [bomLineId], references: [id])
  material                Material?                @relation(fields: [materialId], references: [id])
  componentProduct        Product?                 @relation("MaterialIssueLineComponentProduct", fields: [componentProductId], references: [id])
  uom                     UnitOfMeasure            @relation(fields: [uomId], references: [id])
  ledgerEntry             StockLedgerEntry?
  returns                 MaterialIssueReturn[]
  assemblyBatchComponents AssemblyBatchComponent[]

  @@index([materialIssueId])
  @@map("material_issue_lines")
}

model MaterialIssueReturn {
  id                    String                    @id @default(uuid())
  materialIssueId       String
  materialIssueLineId   String
  returnType            MaterialIssueReturnType
  quantity              Float
  status                MaterialIssueReturnStatus @default(REQUESTED)
  reason                String?
  requestedByActorId    String
  requestedAt           DateTime                  @default(now())
  acknowledgedByActorId String?
  acknowledgedAt        DateTime?
  postedAt              DateTime?

  materialIssue       MaterialIssue     @relation(fields: [materialIssueId], references: [id])
  materialIssueLine   MaterialIssueLine @relation(fields: [materialIssueLineId], references: [id])
  requestedByActor    User              @relation("MaterialIssueReturnRequestedBy", fields: [requestedByActorId], references: [id])
