  objectivePolicy            BusinessObjectivePolicy  @relation(fields: [objectivePolicyId], references: [id], onDelete: Restrict)
  module                     IntelligenceModule
  category                   String
  opportunityRef             String
  status                     RecommendationStatus     @default(OPEN)
  priority                   RecommendationPriority   @default(MEDIUM)
  title                      String
  situation                  String
