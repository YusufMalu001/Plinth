  experienceComplete      Boolean   @default(false)
  agreementsComplete      Boolean   @default(false)
  agreedToTerms           Boolean   @default(false)
  agreedToConductCode     Boolean   @default(false)
  agreedToNda             Boolean   @default(false)
  signatureText           String?
  agreedAt                DateTime?
  completedAt             DateTime?
