enum WipExceptionType {
  DOUBLE_PRESENCE
  NEGATIVE_QUANTITY
  BROKEN_GENEALOGY_CHAIN
  CONSERVATION_MISMATCH
  INVALID_STAGE_TRANSITION
}

enum WipExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum WipExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WipReconciliationException {
  id                    String                   @id @default(uuid())
  batchId               String
  batch                 DepartmentExecutionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productionPlanId      String?
  departmentId          String?
  exceptionType         WipExceptionType
  severity              WipExceptionSeverity     @default(HIGH)
  description           String
  details               Json?
  status                WipExceptionStatus       @default(OPEN)
  detectedAt            DateTime                 @default(now())
  investigatedByActorId String?
  investigatedAt        DateTime?
  investigationNotes    String?
  resolvedByActorId     String?
  resolvedAt            DateTime?
  resolutionNotes       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, detectedAt])
  @@index([batchId, status])
  @@index([departmentId, status])
  @@index([productionPlanId])
  @@map("wip_reconciliation_exceptions")
}

