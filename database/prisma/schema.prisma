  weightDiscrepancy          Decimal               @default(20) @db.Decimal(5, 2)
  weightVendorObligation     Decimal               @default(10) @db.Decimal(5, 2)
  weightCustody              Decimal               @default(10) @db.Decimal(5, 2)
  debitNotePenaltyMultiplier Decimal               @default(2) @db.Decimal(5, 2)
  debitNoteIndividualCap     Decimal               @default(30) @db.Decimal(5, 2)
  discrepancyAggregateCap    Decimal               @default(100) @db.Decimal(5, 2)
  lateObligationBand1Days    Int                   @default(7)
  lateObligationBand1Pts     Decimal               @default(2) @db.Decimal(5, 2)
  lateObligationBand2Days    Int                   @default(30)
  lateObligationBand2Pts     Decimal               @default(5) @db.Decimal(5, 2)
  lateObligationBand3Pts     Decimal               @default(10) @db.Decimal(5, 2)
  custodyAuthorizedLossPct   Decimal               @default(5) @db.Decimal(5, 2)
  rollingWindowDays          Int                   @default(90)
  minEvidenceGrns            Int                   @default(3)
  minEvidencePeriodDays      Int                   @default(14)
  provisionalPolicy          String                @default("NEUTRAL_PRIOR")
