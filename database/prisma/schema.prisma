  expensesPaidThrough MiscellaneousExpense[] @relation("ExpensePaidThroughAccount")

  @@unique([entityId, code])
  @@index([entityId, type, status])
  @@map("ledger_accounts")
}

model AccountingSequence {
  id         String @id @default(uuid())
  entityId   String
  entity     AccountingEntity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  fiscalYear String
  kind       String
  nextNumber Int    @default(1)

  @@unique([entityId, fiscalYear, kind])
  @@map("accounting_sequences")
}

model JournalVoucher {
  id              String   @id @default(uuid())
  entityId        String
  entity          AccountingEntity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  periodId        String
  period          AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
