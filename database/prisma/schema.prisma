  severityLabel        String?
  status               VendorScoringEventStatus @default(ACTIVE)
  reversalOfId         String?                  @unique
  reversalOf           VendorScoringEvent?      @relation("EventReversal", fields: [reversalOfId], references: [id])
  reversedBy           VendorScoringEvent?      @relation("EventReversal")
