datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// ==============================================================================
// CORE & MODULE 0 BASE MODELS
// ==============================================================================

enum Role {
  admin
  manager
  employee
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  name      String?
  firstName String?
  lastName  String?
  password  String
  role      Role    @default(employee)
  isActive  Boolean @default(true)

  // Profile Extended Fields
  employeeId                 String?
  phone                      String?
  department                 String?
  title                      String?
  dateOfHire                 DateTime?
  employeeStatus             String?                       @default("Active")
  mustChangePassword         Boolean                       @default(false)
  initialPassword            String?
  onboardingCompleted        Boolean                       @default(false)
  onboardingToken            String?                       @unique
  employeeRefId              String?
  employeeRef                Employee?                     @relation("UserEmployeeProfile", fields: [employeeRefId], references: [id], onDelete: SetNull)
  lastLoginAt                DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  auditLogs                  AuditLog[]
  authSessions               AuthSession[]
  purchaseRequisitions       PurchaseRequisition[]         @relation("PrRequester")
  procurementApprovals       ProcurementApproval[]         @relation("ApprovalActor")
  transmissionLogs           TransmissionLog[]             @relation("TransmissionActor")
  procurementDocuments       ProcurementDocument[]         @relation("DocumentUploader")
  grnsReceived               GoodsReceiptNote[]            @relation("GrnReceivedBy")
  grnsVerified               GoodsReceiptNote[]            @relation("GrnVerifiedBy")
  grnsSignedOff              GoodsReceiptNote[]            @relation("GrnSignedOffBy")
  grnsFinalized              GoodsReceiptNote[]            @relation("GrnFinalizedBy")
  grnMeasurements            GoodsReceiptMeasurement[]     @relation("GrnMeasuredBy")
  grnDiscrepancyResolutions  GoodsReceiptDiscrepancy[]     @relation("GrnDiscrepancyResolvedBy")
  grnLabelPrintEvents        GoodsReceiptLabelPrintEvent[] @relation("GrnLabelPrintedBy")
  grnDocumentsUploaded       GrnDocument[]                 @relation("GrnDocumentUploader")
  notifications              Notification[]                @relation("NotificationRecipient")
  recommendationDecisions    RecommendationDecision[]      @relation("RecommendationDecisionActor")
  businessTasksOwned         BusinessTask[]                @relation("BusinessTaskOwner")
  businessTasksCreated       BusinessTask[]                @relation("BusinessTaskCreator")
  businessTaskActivities     BusinessTaskActivity[]        @relation("BusinessTaskActivityActor")
  recommendationOutcomes     RecommendationOutcome[]       @relation("RecommendationOutcomeRecorder")
  intelligencePolicies       BusinessObjectivePolicy[]     @relation("BusinessObjectivePolicyApprover")
  intelligenceControlUpdates IntelligenceControlState[]    @relation("IntelligenceControlStateUpdater")
  intelligenceConversations  Conversation[]                @relation("IntelligenceConversationOwner")

  // BOM Relations (Module 5)
  bomsCreated       BomVersion[]       @relation("BomCreatedBy")
  bomsSubmitted     BomVersion[]       @relation("BomSubmittedBy")
  bomsValidated     BomVersion[]       @relation("BomValidatedBy")
  bomsApproved      BomVersion[]       @relation("BomApprovedBy")
  bomsRetired       BomVersion[]       @relation("BomRetiredBy")
  bomGoldenExamples BomGoldenExample[] @relation("BomGoldenExampleCreatedBy")
  bomSimulationRuns BomSimulationRun[] @relation("BomSimulationRunBy")

  // Production Plan Relations (Module 6)
  productionPlansOwned       ProductionPlan[]      @relation("ProductionPlanOwner")
  productionPlansCreated     ProductionPlan[]      @relation("ProductionPlanCreatedBy")
  productionPlansChecked     ProductionPlan[]      @relation("ProductionPlanCheckedBy")
  productionPlansSubmitted   ProductionPlan[]      @relation("ProductionPlanSubmittedBy")
  productionPlansApproved    ProductionPlan[]      @relation("ProductionPlanApprovedBy")
  productionPlansReleased    ProductionPlan[]      @relation("ProductionPlanReleasedBy")
  productionPlansCancelled   ProductionPlan[]      @relation("ProductionPlanCancelledBy")
  productionPlansModified    ProductionPlan[]      @relation("ProductionPlanModifiedBy")
  productionPlansInterrupted ProductionPlan[]      @relation("ProductionPlanInterruptedBy")
  productionPlanEvents       ProductionPlanEvent[]

  // RBAC scope assignment (Module 0 dynamic RBAC)
  assignedOrganizationId           String?
  assignedOrganization             Factory?              @relation("UserAssignedOrganization", fields: [assignedOrganizationId], references: [id], onDelete: SetNull)
  assignedLocationId               String?
  assignedLocation                 WarehouseLocation?    @relation("UserAssignedLocation", fields: [assignedLocationId], references: [id], onDelete: SetNull)
  assignedDepartmentId             String?
  assignedDepartmentRef            Department?           @relation("UserAssignedDepartment", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  userRoles                        UserRole[]
  stockLedgerPostEvents            StockLedgerEntry[]    @relation("StockLedgerPostedBy")
  stockAdjustmentsApproved         StockAdjustment[]     @relation("StockAdjustmentApprovedBy")
  stockAdjustmentsProposed         StockAdjustment[]     @relation("StockAdjustmentProposedBy")
  stockAdjustmentsRejected         StockAdjustment[]     @relation("StockAdjustmentRejectedBy")
  stockAdjustmentsReviewed         StockAdjustment[]     @relation("StockAdjustmentReviewedBy")
  stockIssuesIssued                StockIssue[]          @relation("StockIssueIssuedBy")
  stockIssuesReversed              StockIssue[]          @relation("StockIssueReversedBy")
  stockReservationsReleased        StockReservation[]    @relation("StockReservationReleasedBy")
  stockReservationsReserved        StockReservation[]    @relation("StockReservationReservedBy")
  stockSnapshotsCreated            StockSnapshot[]       @relation("StockSnapshotCreatedBy")
  stockTransfersCancelled          StockTransfer[]       @relation("StockTransferCancelledBy")
  stockTransfersIssued             StockTransfer[]       @relation("StockTransferIssuedBy")
  stockTransfersReceived           StockTransfer[]       @relation("StockTransferReceivedBy")
  stockTransfersRequested          StockTransfer[]       @relation("StockTransferRequestedBy")
  materialIssuesRequested          MaterialIssue[]       @relation("MaterialIssueRequestedBy")
  materialIssuesVerified           MaterialIssue[]       @relation("MaterialIssueVerifiedBy")
  materialIssuesPrepared           MaterialIssue[]       @relation("MaterialIssuePreparedBy")
  materialIssuesHandedOver         MaterialIssue[]       @relation("MaterialIssueHandedOverBy")
  materialIssuesAcknowledged       MaterialIssue[]       @relation("MaterialIssueAcknowledgedBy")
  materialIssuesCancelled          MaterialIssue[]       @relation("MaterialIssueCancelledBy")
  materialIssueReturnsRequested    MaterialIssueReturn[] @relation("MaterialIssueReturnRequestedBy")
  materialIssueReturnsAcknowledged MaterialIssueReturn[] @relation("MaterialIssueReturnAcknowledgedBy")

  // Module 18 - Finance / Tally Integration Relations
  mappingConfigsCreated       MappingConfiguration[] @relation("MappingConfigCreator")
  mappingConfigsApproved      MappingConfiguration[] @relation("MappingConfigApprover")
  integrationJobsTriggered    IntegrationJob[]       @relation("IntegrationJobTriggeredBy")
  jobItemsAcknowledged        IntegrationJobItem[]   @relation("JobItemAcknowledgedBy")
  reconciliationsInvestigated ReconciliationRecord[] @relation("ReconciliationInvestigatedBy")

  // Module 11 - Loss, Damage & Waste Management Relations
  lossEventsReported              LossEvent[]          @relation("LossEventReportedBy")
  lossEventsReviewed              LossEvent[]          @relation("LossEventReviewedBy")
  lossEventsApproved              LossEvent[]          @relation("LossEventApprovedBy")
  lossEventsRejected              LossEvent[]          @relation("LossEventRejectedBy")
  lossEventsInvestigated          LossEvent[]          @relation("LossEventInvestigatedBy")
  replacementChallansIssued       ReplacementChallan[] @relation("ReplacementChallanIssuedBy")
  replacementChallansAcknowledged ReplacementChallan[] @relation("ReplacementChallanAcknowledgedBy")

  // Module 12 - Assembly Execution Relations
  assemblyBatchesCreated   AssemblyBatch[]            @relation("AssemblyBatchCreatedBy")
  assemblyBatchesAllocated AssemblyBatch[]            @relation("AssemblyBatchAllocatedBy")
  assemblyBatchesCompleted AssemblyBatch[]            @relation("AssemblyBatchCompletedBy")
  assemblyWorkersAssigned  AssemblyWorkerAssignment[] @relation("AssemblyWorkerAssignedBy")

  // Module 13 - Finished Goods Receiving Relations
  fgReceiptsReceived         FgReceipt[]             @relation("FgReceiptReceivedBy")
  fgReceiptsHeld             FgReceipt[]             @relation("FgReceiptHeldBy")
  fgReceiptsReleased         FgReceipt[]             @relation("FgReceiptReleasedBy")
  fgPackagingUpdated         FgPackagingRecord[]     @relation("FgPackagingUpdatedBy")
  // Module 14 - Job Work / Outsourced Processing Relations
  jobWorkOrdersCreated       JobWorkOrder[]          @relation("JobWorkOrderCreatedBy")
  jobWorkOrdersApproved      JobWorkOrder[]          @relation("JobWorkOrderApprovedBy")
  jobWorkOrdersClosed        JobWorkOrder[]          @relation("JobWorkOrderClosedBy")
  jobWorkChallansIssued      JobWorkMaterialIssue[]  @relation("JobWorkChallanIssuedBy")
  jobWorkReturnsReceived     JobWorkReceiptReturn[]  @relation("JobWorkReturnReceivedBy")
  jobWorkReconciliationsDone JobWorkReconciliation[] @relation("JobWorkReconciliationDoneBy")
  miscellaneousExpenses      MiscellaneousExpense[]  @relation("UserExpenses")

  @@map("users")
}

// ==============================================================================
// DYNAMIC RBAC (Role/Permission/UserRole) — scoped to GRN + Procurement modules
// ==============================================================================

model RbacRole {
  id           String           @id @default(uuid())
  name         String           @unique // e.g. "admin", "grn_clerk", "grn_verifier", "grn_supervisor", "procurement_officer", "procurement_manager"
  description  String?
  isSystem     Boolean          @default(false)
  allLocations Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@map("rbac_roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  action      String
  resource    String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String? // null = ungated; set = grant applies only within this Factory
  organization   Factory? @relation("UserRoleOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  requestId  String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model HealthCheckLog {
  id        String   @id @default(uuid())
  status    String
  latencyMs Int
  timestamp DateTime @default(now())

  @@map("health_check_logs")
}

// ==============================================================================
// MODULE 1 - MASTER DATA MANAGEMENT ENUMS
// ==============================================================================

enum LifecycleStatus {
  DRAFT
  PENDING_VALIDATION
  APPROVED
  ACTIVE
  INACTIVE
  SUPERSEDED
}

enum MaterialType {
  RAW_MATERIAL
  HARDWARE
  PACKAGING
  COMPONENT
}

enum ImportBatchStatus {
  PENDING_VALIDATION
  VALIDATED
  PARTIALLY_COMMITTED
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  COMMITTED
  SKIPPED
  DUPLICATE_FLAGGED
}

// ==============================================================================
// MODULE 1 - PRODUCT HIERARCHY & SPECIFICATIONS
// ==============================================================================

model Category {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  parentId        String?
  parent          Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]      @relation("CategoryHierarchy")
  status          LifecycleStatus @default(DRAFT)
  deactivatedAt   DateTime?
  supersededById  String?         @unique
  supersededBy    Category?       @relation("CategorySupersession", fields: [supersededById], references: [id])
  supersedes      Category?       @relation("CategorySupersession")
  productFamilies ProductFamily[]
  products        Product[]
  materials       Material[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("categories")
}

model ProductFamily {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  description    String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status         LifecycleStatus @default(DRAFT)
  deactivatedAt  DateTime?
  supersededById String?         @unique
  supersededBy   ProductFamily?  @relation("ProductFamilySupersession", fields: [supersededById], references: [id])
  supersedes     ProductFamily?  @relation("ProductFamilySupersession")
  products       Product[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("product_families")
}

model Product {
  id                         String                    @id @default(uuid())
  sku                        String                    @unique
  name                       String
  description                String?
  productFamilyId            String
  productFamily              ProductFamily             @relation(fields: [productFamilyId], references: [id], onDelete: Restrict)
  categoryId                 String
  category                   Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uomId                      String
  uom                        UnitOfMeasure             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  status                     LifecycleStatus           @default(DRAFT)
  version                    Int                       @default(1)
  effectiveDate              DateTime?
  metadata                   Json?
  traceabilityMode           String                    @default("QUANTITY")
  expiryTracking             Boolean                   @default(false)
  issueStrategy              String                    @default("FIFO")
  shelfLifeWarningDays       Int?
  defaultReceivingLocationId String?
  defaultPickingLocationId   String?
  deactivatedAt              DateTime?
  supersededById             String?                   @unique
  supersededBy               Product?                  @relation("ProductSupersession", fields: [supersededById], references: [id])
  supersedes                 Product?                  @relation("ProductSupersession")
  variants                   ProductVariant[]
  routes                     ProductRoute[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  PurchaseRequisitionLine    PurchaseRequisitionLine[]
  PurchaseOrderLine          PurchaseOrderLine[]
  goodsReceiptLines          GoodsReceiptLine[]
  stockLedgerEntries         StockLedgerEntry[]
  bomVersions                BomVersion[]
  bomLinesComponent          BomLine[]                 @relation("BomLineComponentProduct")
  productionPlans            ProductionPlan[]
  materialIssueLines         MaterialIssueLine[]       @relation("MaterialIssueLineComponentProduct")
  stockAdjustments           StockAdjustment[]
  stockBalances              StockBalance[]
  stockIssues                StockIssue[]
  stockReservations          StockReservation[]
  stockSnapshots             StockSnapshot[]
  stockTransfers             StockTransfer[]
  LossEvent                  LossEvent[]
  ReplacementChallan         ReplacementChallan[]
  assemblyBatches            AssemblyBatch[]           @relation("AssemblyProduct")
  fgReadyOutputs             FgReadyOutput[]
  fgReceipts                 FgReceipt[]
  JobWorkOrder               JobWorkOrder[]
  JobWorkOrderLine           JobWorkOrderLine[]
  JobWorkMaterialIssue       JobWorkMaterialIssue[]
  JobWorkCustodyLedger       JobWorkCustodyLedger[]
  JobWorkReceiptReturn       JobWorkReceiptReturn[]

  @@map("products")
}

model ProductSpecialPreset {
  id              String   @id @default(uuid())
  name            String   @default("")
  description     String?
  hsnCode         String   @default("")
  taxability      String   @default("Taxable")
  uomId           String   @default("")
  uomCode         String   @default("NOS")
  gstRate         String   @default("18")
  initialQuantity String   @default("0")
  isSystemDefault Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isDeleted, name])
  @@map("product_special_presets")
}

model ProductVariant {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String          @unique
  name            String
  color           String?
  size            String?
  specifications  Json?
  status          LifecycleStatus @default(DRAFT)
  version         Int             @default(1)
  deactivatedAt   DateTime?
  supersededById  String?         @unique
  supersededBy    ProductVariant? @relation("ProductVariantSupersession", fields: [supersededById], references: [id])
  supersedes      ProductVariant? @relation("ProductVariantSupersession")
  routes          ProductRoute[]
  bomVersions     BomVersion[]
  assemblyBatches AssemblyBatch[]
  fgReadyOutputs  FgReadyOutput[]
  fgReceipts      FgReceipt[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("product_variants")
}

// ==============================================================================
// MODULE 1 - MATERIALS, COMPONENTS & PACKAGING
// ==============================================================================

model Material {
  id                         String                    @id @default(uuid())
  code                       String                    @unique
  name                       String
  description                String?
  materialType               MaterialType
  categoryId                 String?
  category                   Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uomId                      String
  uom                        UnitOfMeasure             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  specs                      Json
  traceabilityMode           String                    @default("QUANTITY")
  expiryTracking             Boolean                   @default(false)
  issueStrategy              String                    @default("FIFO")
  shelfLifeWarningDays       Int?
  defaultReceivingLocationId String?
  defaultPickingLocationId   String?
  status                     LifecycleStatus           @default(DRAFT)
  version                    Int                       @default(1)
  effectiveDate              DateTime?
  deactivatedAt              DateTime?
  supersededById             String?                   @unique
  supersededBy               Material?                 @relation("MaterialSupersession", fields: [supersededById], references: [id])
  supersedes                 Material?                 @relation("MaterialSupersession")
  productionRoutes           ProductRoute[]            @relation("RouteMaterial")
  bomVersions                BomVersion[]
  packSizes                  PackSize[]
  wastageRules               WastageRule[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  PurchaseRequisitionLine    PurchaseRequisitionLine[]
  PurchaseOrderLine          PurchaseOrderLine[]
  goodsReceiptLines          GoodsReceiptLine[]
  stockLedgerEntries         StockLedgerEntry[]
  bomLines                   BomLine[]
  materialIssueLines         MaterialIssueLine[]
  stockAdjustments           StockAdjustment[]
  stockBalances              StockBalance[]
  stockIssues                StockIssue[]
  stockReservations          StockReservation[]
  stockSnapshots             StockSnapshot[]
  stockTransfers             StockTransfer[]
  LossEvent                  LossEvent[]
  ReplacementChallan         ReplacementChallan[]
  JobWorkOrderLine           JobWorkOrderLine[]
  JobWorkMaterialIssue       JobWorkMaterialIssue[]
  JobWorkCustodyLedger       JobWorkCustodyLedger[]
  JobWorkReceiptReturn       JobWorkReceiptReturn[]

  @@map("materials")
}

// ==============================================================================
// MODULE 1 - UNITS OF MEASURE, CONVERSIONS & PACK SIZES
// ==============================================================================

model UnitOfMeasure {
  id                        String                      @id @default(uuid())
  code                      String                      @unique
  name                      String
  symbol                    String
  dimension                 String?
  allowFractional           Boolean                     @default(true)
  status                    LifecycleStatus             @default(DRAFT)
  deactivatedAt             DateTime?
  products                  Product[]
  materials                 Material[]
  conversionsFrom           UomConversion[]             @relation("FromUom")
  conversionsTo             UomConversion[]             @relation("ToUom")
  packSizes                 PackSize[]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  PurchaseRequisitionLine   PurchaseRequisitionLine[]
  PurchaseOrderLine         PurchaseOrderLine[]
  goodsReceiptLines         GoodsReceiptLine[]
  stockLedgerEntries        StockLedgerEntry[]
  bomLines                  BomLine[]
  bomGoldenExamples         BomGoldenExample[]
  bomSimulationRuns         BomSimulationRun[]
  productionPlanQuantities  ProductionPlan[]            @relation("ProductionPlanQuantityUom")
  productionRequirementUoms ProductionPlanRequirement[] @relation("ProductionRequirementUom")
  productionInventoryUoms   ProductionPlanRequirement[] @relation("ProductionRequirementInventoryUom")
  productionIssueUoms       ProductionMaterialIssue[]   @relation("ProductionIssueUom")
  productionOutputUoms      ProductionOutput[]          @relation("ProductionOutputUom")
  materialIssueLines        MaterialIssueLine[]
  stockAdjustments          StockAdjustment[]
  stockBalances             StockBalance[]
  stockIssues               StockIssue[]
  stockReservations         StockReservation[]
  stockSnapshots            StockSnapshot[]
  stockTransfers            StockTransfer[]
  LossEvent                 LossEvent[]
  ReplacementChallan        ReplacementChallan[]
  assemblyBatchComponents   AssemblyBatchComponent[]
  fgReadyOutputs            FgReadyOutput[]
  fgReceipts                FgReceipt[]
  JobWorkOrder              JobWorkOrder[]
  JobWorkOrderLine          JobWorkOrderLine[]
  JobWorkMaterialIssue      JobWorkMaterialIssue[]
  JobWorkCustodyLedger      JobWorkCustodyLedger[]
  JobWorkReceiptReturn      JobWorkReceiptReturn[]

  @@map("units_of_measure")
}

model HsnSacCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  kind        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@map("hsn_sac_codes")
}

model PricingMaster {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  fields      Json
  columns     Json            @default("[]")
  tiers       Json            @default("[]")
  status      LifecycleStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("pricing_masters")
}

model UomConversion {
  id             String          @id @default(uuid())
  fromUomId      String
  fromUom        UnitOfMeasure   @relation("FromUom", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUomId        String
  toUom          UnitOfMeasure   @relation("ToUom", fields: [toUomId], references: [id], onDelete: Restrict)
  factor         Decimal         @db.Decimal(18, 6)
  effectiveDate  DateTime
  version        Int             @default(1)
  status         LifecycleStatus @default(DRAFT)
  deactivatedAt  DateTime?
  supersededById String?         @unique
  supersededBy   UomConversion?  @relation("UomConversionSupersession", fields: [supersededById], references: [id])
  supersedes     UomConversion?  @relation("UomConversionSupersession")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([fromUomId, toUomId, version])
  @@map("uom_conversions")
}

model PackSize {
  id             String          @id @default(uuid())
  materialId     String
  material       Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  packQty        Decimal         @db.Decimal(18, 4)
  uomId          String
  uom            UnitOfMeasure   @relation(fields: [uomId], references: [id], onDelete: Restrict)
  effectiveDate  DateTime
  version        Int             @default(1)
  status         LifecycleStatus @default(DRAFT)
  deactivatedAt  DateTime?
  supersededById String?         @unique
  supersededBy   PackSize?       @relation("PackSizeSupersession", fields: [supersededById], references: [id])
  supersedes     PackSize?       @relation("PackSizeSupersession")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([materialId, uomId, version])
  @@map("pack_sizes")
}

// ==============================================================================
// MODULE 1 - EXTERNAL & INTERNAL MASTER ENTITIES
// ==============================================================================

model Vendor {
  id                   String                     @id @default(uuid())
  code                 String                     @unique
  name                 String
  legalName            String?
  contactEmail         String?
  contactPhone         String?
  taxNumber            String?
  address              Json?
  currency             String                     @default("INR")
  paymentTerms         String?
  leadTimeDays         Int?
  status               LifecycleStatus            @default(DRAFT)
  deactivatedAt        DateTime?
  supersededById       String?                    @unique
  supersededBy         Vendor?                    @relation("VendorSupersession", fields: [supersededById], references: [id])
  supersedes           Vendor?                    @relation("VendorSupersession")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  PurchaseOrder        PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceiptNotes    GoodsReceiptNote[]
  contacts             VendorContact[]
  capabilities         VendorCapability[]
  complianceDocuments  VendorComplianceDocument[]
  evaluations          VendorEvaluation[]
  scoreSnapshots       VendorScoreSnapshot[]
  ReplacementChallan   ReplacementChallan[]
  jobWorkOrders        JobWorkOrder[]
  jobWorkChallans      JobWorkMaterialIssue[]
  jobWorkLedgerEntries JobWorkCustodyLedger[]
  jobWorkReturns       JobWorkReceiptReturn[]
  purchaseBills        PurchaseBill[]
  scoringEvents        VendorScoringEvent[]

  @@map("vendors")
}

model Customer {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  contactEmail    String?
  contactPhone    String?
  taxNumber       String?
  billingAddress  Json?
  shippingAddress Json?
  currency        String          @default("INR")
  creditLimit     Decimal?        @db.Decimal(18, 2)
  status          LifecycleStatus @default(DRAFT)
  deactivatedAt   DateTime?
  supersededById  String?         @unique
  supersededBy    Customer?       @relation("CustomerSupersession", fields: [supersededById], references: [id])
  supersedes      Customer?       @relation("CustomerSupersession")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("customers")
}

model Employee {
  id                        String                     @id @default(uuid())
  employeeCode              String                     @unique
  firstName                 String
  lastName                  String
  email                     String                     @unique
  phone                     String?
  role                      String
  departmentId              String?
  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status                    LifecycleStatus            @default(DRAFT)
  deactivatedAt             DateTime?
  workerAssignments         WorkerAssignment[]
  progressEvents            ProgressEvent[]
  exceptionRecords          ExceptionRecord[]
  inspections               InspectionResult[]
  assignedCorrectiveActions CorrectiveAction[]
  assemblyWorkerAssignments AssemblyWorkerAssignment[] @relation("AssemblyWorkerEmployee")
  assemblyProgressEvents    AssemblyProgressEvent[]    @relation("AssemblyProgressEmployee")

  // HR Module Extended Fields
  gender         String? // "Male", "Female", "Non-Binary", "Other"
  dateOfBirth    DateTime?
  hireDate       DateTime?  @default(now())
  ranking        Int?       @default(1) // 1 (Junior/L1) to 10 (Executive/CXO)
  designation    String?
  hierarchyLevel Int?       @default(1) // 1=Top Management, 2=Senior/Head, 3=Lead, 4=Staff, 5=Associate/Worker
  baseSalary     Decimal?   @default(0) @db.Decimal(12, 2)
  hourlyRate     Decimal?   @db.Decimal(10, 2)
  managerId      String?
  manager        Employee?  @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[] @relation("EmployeeHierarchy")

  // Address & Personal details
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String? @default("India")
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  maritalStatus            String?

  // Financial & Tax Details
  bankAccountNumber String?
  bankName          String?
  bankIfscCode      String?
  panNumber         String?
  aadhaarNumber     String?
  pfNumber          String?
  esiNumber         String?

  // Onboarding status
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // HR Relations
  tasks             EmployeeTask[]
  attendances       Attendance[]
  paySlips          PaySlip[]
  documents         EmployeeDocument[]
  workExperiences   WorkExperience[]
  onboardingDetails OnboardingDetails?
  userAccounts      User[]                   @relation("UserEmployeeProfile")
  scoringSnapshots  EmployeeScoreSnapshot[]
  goals             EmployeeGoal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
  ON_HOLD
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model EmployeeTask {
  id          String       @id @default(uuid())
  title       String
  description String?
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
