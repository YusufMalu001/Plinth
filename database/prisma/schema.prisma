model Recommendation {
  id                         String                   @id @default(uuid())
  runId                      String
  run                        IntelligenceRun          @relation(fields: [runId], references: [id], onDelete: Restrict)
  snapshotId                 String
  snapshot                   BusinessSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
