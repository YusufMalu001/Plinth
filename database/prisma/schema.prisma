model Factory {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  address        Json?
  status         LifecycleStatus     @default(DRAFT)
  deactivatedAt  DateTime?
  departments    Department[]
  locations      WarehouseLocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  usersAssigned  User[]              @relation("UserAssignedOrganization")
  userRoleGrants UserRole[]          @relation("UserRoleOrganization")

  @@map("factories")
}

model Department {
  id                  String                     @id @default(uuid())
  code                String                     @unique
  name                String
  factoryId           String
  factory             Factory                    @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  status              LifecycleStatus            @default(DRAFT)
  deactivatedAt       DateTime?
  departmentHead      String?
  description         String?
  isAssembly          Boolean                    @default(false)
  workCenters         WorkCenter[]
  employees           Employee[]
  routeSteps          RouteStep[]
  incomingRouteSteps  RouteStep[]                 @relation("RouteStepNextDepartment")
  assemblyRoutes      ProductRoute[]             @relation("RouteAssemblyDepartment")
  bomLines            BomLine[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  PurchaseRequisition PurchaseRequisition[]
  usersAssigned       User[]                     @relation("UserAssignedDepartment")
  batches             DepartmentExecutionBatch[]
  outgoingHandovers   Handover[]                 @relation("OutgoingDepartmentHandovers")
  incomingHandovers   Handover[]                 @relation("IncomingDepartmentHandovers")
  LossEvent           LossEvent[]
  ReplacementChallan  ReplacementChallan[]

  @@map("departments")
}

model WorkCenter {
  id              String                     @id @default(uuid())
  code            String                     @unique
  name            String
  departmentId    String
  department      Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  capacityPerHour Decimal?                   @db.Decimal(10, 2)
  status          LifecycleStatus            @default(DRAFT)
  deactivatedAt   DateTime?
  routeSteps      RouteStep[]
  batches         DepartmentExecutionBatch[]
  wastageRules    WastageRule[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@map("work_centers")
}

model WarehouseLocation {
  id                       String                  @id @default(uuid())
  code                     String                  @unique
  name                     String
  factoryId                String?
  factory                  Factory?                @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  parentLocationId         String?
  parentLocation           WarehouseLocation?      @relation("WarehouseLocationTree", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations           WarehouseLocation[]     @relation("WarehouseLocationTree")
  barcode                  String?                 @unique
  type                     String
  status                   LifecycleStatus         @default(DRAFT)
  fulfillmentV2Enabled     Boolean                 @default(true)
  deactivatedAt            DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  usersAssigned            User[]                  @relation("UserAssignedLocation")
  goodsReceiptNotes        GoodsReceiptNote[]
  stockLedgerEntries       StockLedgerEntry[]
  productionPlansTargeting ProductionPlan[]        @relation("ProductionPlanTargetLocation")
  materialIssues           MaterialIssue[]
  stockAdjustments         StockAdjustment[]
  stockBalances            StockBalance[]
  stockIssues              StockIssue[]
  stockReservations        StockReservation[]
  stockSnapshots           StockSnapshot[]
  stockTransfersFrom       StockTransfer[]         @relation("StockTransferFromLocation")
  stockTransfersTo         StockTransfer[]         @relation("StockTransferToLocation")
  LossEvent                LossEvent[]
  fgReceipts               FgReceipt[]
  fgPackagingStaging       FgPackagingRecord[]
  salesFulfillments        SalesFulfillment[]
  salesShipments           SalesShipment[]
  salesDispatchManifests   SalesDispatchManifest[]
  ReplacementChallan       ReplacementChallan[]
  JobWorkOrder             JobWorkOrder[]
  JobWorkMaterialIssue     JobWorkMaterialIssue[]
  JobWorkReceiptReturn     JobWorkReceiptReturn[]

  @@map("warehouse_locations")
}

// ==============================================================================
// MODULE 1 - QC, WASTAGE RULES & PRODUCTION ROUTING
// ==============================================================================

model QcRule {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  description       String?
  targetType        String
  targetId          String?
  parameters        Json
  version           Int                @default(1)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            LifecycleStatus    @default(DRAFT)
  deactivatedAt     DateTime?
  supersededById    String?            @unique
  supersededBy      QcRule?            @relation("QcRuleSupersession", fields: [supersededById], references: [id])
  supersedes        QcRule?            @relation("QcRuleSupersession")
  routeSteps        RouteStep[]
  inspectionResults InspectionResult[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("qc_rules")
}

model WastageRule {
  id                 String          @id @default(uuid())
  code               String          @unique
  name               String
  materialId         String?
  material           Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  workCenterId       String?
  workCenter         WorkCenter?     @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  standardWastagePct Decimal         @db.Decimal(5, 2)
  tolerancePct       Decimal         @db.Decimal(5, 2)
  version            Int             @default(1)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  status             LifecycleStatus @default(DRAFT)
  deactivatedAt      DateTime?
  supersededById     String?         @unique
  supersededBy       WastageRule?    @relation("WastageRuleSupersession", fields: [supersededById], references: [id])
  supersedes         WastageRule?    @relation("WastageRuleSupersession")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  LossEvent          LossEvent[]

  @@map("wastage_rules")
}

model ProductRoute {
  id               String           @id @default(uuid())
  code             String           @unique
  name             String
  productId        String?
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  materialId       String?
  material         Material?        @relation("RouteMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  version          Int              @default(1)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           LifecycleStatus  @default(DRAFT)
  deactivatedAt    DateTime?
  supersededById   String?          @unique
  supersededBy     ProductRoute?    @relation("ProductRouteSupersession", fields: [supersededById], references: [id])
  supersedes       ProductRoute?    @relation("ProductRouteSupersession")
  steps            RouteStep[]
  assemblyDepartmentId String?
  assemblyDepartment Department? @relation("RouteAssemblyDepartment", fields: [assemblyDepartmentId], references: [id], onDelete: Restrict)
  bomVersionId     String?
  bomVersion       BomVersion? @relation("RouteBomVersion", fields: [bomVersionId], references: [id], onDelete: Restrict)
  graphReviewedAt  DateTime?
  materialAllocations RouteMaterialAllocation[]
  productionPlans  ProductionPlan[]
  assemblyBatches  AssemblyBatch[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([materialId])
  @@map("product_routes")
}

model RouteStep {
  id                      String                     @id @default(uuid())
  routeId                 String
  route                   ProductRoute               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequenceNumber          Int
  branchKey               String?
  stepOrder               Int?
  parentStepId            String?                    @unique
  parentStep              RouteStep?                 @relation("RouteStepChain", fields: [parentStepId], references: [id], onDelete: SetNull)
  nextStep                RouteStep?                 @relation("RouteStepChain")
  outputItemType          String?
  outputItemId            String?
  outputUomId             String?
  outputQuantityPerUnit   Decimal?                   @db.Decimal(18, 6)
  materialAllocations     RouteMaterialAllocation[]
  assemblyIntakes         AssemblyIntakeRequirement[]
  stepName                String
  workCenterId            String?
  workCenter              WorkCenter?                @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  departmentId            String
  department              Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  nextDepartmentId        String?
  nextDepartment          Department?                @relation("RouteStepNextDepartment", fields: [nextDepartmentId], references: [id], onDelete: SetNull)
  standardDurationMinutes Int?
  isQcRequired            Boolean                    @default(false)
  qcRuleId                String?
  qcRule                  QcRule?                    @relation(fields: [qcRuleId], references: [id], onDelete: SetNull)
  status                  LifecycleStatus            @default(DRAFT)
  batches                 DepartmentExecutionBatch[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([routeId, branchKey, stepOrder])
  @@map("route_steps")
}

model RouteMaterialAllocation {
  id          String       @id @default(uuid())
  routeId     String
  route       ProductRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bomLineId   String
  bomLine     BomLine      @relation(fields: [bomLineId], references: [id], onDelete: Restrict)
  routeStepId String?
  routeStep   RouteStep?   @relation(fields: [routeStepId], references: [id], onDelete: Cascade)
  quantity    Decimal      @db.Decimal(18, 6)
  createdAt   DateTime     @default(now())

  @@index([routeId, bomLineId])
  @@index([routeStepId])
  @@map("route_material_allocations")
}

// ==============================================================================
// MODULE 1 - STAGED MASTER DATA IMPORT WORKFLOW
// ==============================================================================

model MasterDataImportBatch {
  id            String                @id @default(uuid())
  batchNumber   String                @unique
  entityType    String
  totalRows     Int                   @default(0)
  validRows     Int                   @default(0)
  invalidRows   Int                   @default(0)
  committedRows Int                   @default(0)
  status        ImportBatchStatus     @default(PENDING_VALIDATION)
  importedBy    String
  metadata      Json?
  rows          MasterDataImportRow[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("master_data_import_batches")
}

model MasterDataImportRow {
  id                 String                @id @default(uuid())
  batchId            String
  batch              MasterDataImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber          Int
  rawData            Json
  normalizedData     Json?
  status             ImportRowStatus       @default(PENDING)
  errors             Json?
  duplicateMatchId   String?
  resolutionDecision String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([batchId, rowNumber])
  @@map("master_data_import_rows")
}

