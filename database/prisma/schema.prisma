}

model AccountingEntity {
  id          String   @id @default(uuid())
  code        String   @unique
  legalName   String
  baseCurrency String  @default("INR")
  gstin       String?
  stateCode   String?
  status      String   @default("CONFIGURING")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  periods         AccountingPeriod[]
  ledgerAccounts  LedgerAccount[]
  sequences       AccountingSequence[]
  journalVouchers JournalVoucher[]
  purchaseBills   PurchaseBill[]
  miscellaneousExpenses MiscellaneousExpense[]

  @@map("accounting_entities")
}

model AccountingPeriod {
  id        String   @id @default(uuid())
  entityId  String
  entity    AccountingEntity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  code      String
  fiscalYear String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  status    String   @default("OPEN")
