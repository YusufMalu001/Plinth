model MaterialIssue {
  id                    String              @id @default(uuid())
  issueNumber           String              @unique
  productionPlanId      String
  bomVersionId          String
  locationId            String
  idempotencyKey        String?             @unique
  challanNumber         String?             @unique
  status                MaterialIssueStatus @default(REQUESTED)
  note                  String?
  requestedByActorId    String
  requestedAt           DateTime            @default(now())
  verifiedByActorId     String?
  verifiedAt            DateTime?
  preparedByActorId     String?
  preparedAt            DateTime?
  handedOverByActorId   String?
  handedOverAt          DateTime?
  acknowledgedByActorId String?
  acknowledgedAt        DateTime?
  postedAt              DateTime?
  cancelledByActorId    String?
  cancelledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  productionPlan      ProductionPlan        @relation(fields: [productionPlanId], references: [id])
  bomVersion          BomVersion            @relation(fields: [bomVersionId], references: [id])
  location            WarehouseLocation     @relation(fields: [locationId], references: [id])
  requestedByActor    User                  @relation("MaterialIssueRequestedBy", fields: [requestedByActorId], references: [id])
  verifiedByActor     User?                 @relation("MaterialIssueVerifiedBy", fields: [verifiedByActorId], references: [id])
  preparedByActor     User?                 @relation("MaterialIssuePreparedBy", fields: [preparedByActorId], references: [id])
  handedOverByActor   User?                 @relation("MaterialIssueHandedOverBy", fields: [handedOverByActorId], references: [id])
  acknowledgedByActor User?                 @relation("MaterialIssueAcknowledgedBy", fields: [acknowledgedByActorId], references: [id])
  cancelledByActor    User?                 @relation("MaterialIssueCancelledBy", fields: [cancelledByActorId], references: [id])
