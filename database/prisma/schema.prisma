// ==============================================================================
// MODULE 3 - GOODS RECEIPT / GRN MODELS
// ==============================================================================

model GoodsReceiptNote {
  id                        String                @id @default(uuid())
  // TO BE VALIDATED: Default sequential numbering scheme, mirrors the same open question
  // already recorded for PurchaseOrder.poNumber above. Confirm with Plinth if a structured
  // code like GRN-YYYY-MM-SEQ is the required format.
  grnNumber                 String                @unique
  poId                      String?
  po                        PurchaseOrder?        @relation(fields: [poId], references: [id], onDelete: Restrict)
  vendorId                  String?
  vendor                    Vendor?               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  isUnreferenced            Boolean               @default(false)
  unreferencedJustification String?
  // Nullable for backward compatibility with GRNs created before location scoping existed;
  // enforced as required at the API layer for all new GRNs.
  locationId                String?
  location                  WarehouseLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status                    GrnStatus             @default(ARRIVED)
  idempotencyKey            String?               @unique
  receivedByActorId         String
  receivedByActor           User                  @relation("GrnReceivedBy", fields: [receivedByActorId], references: [id], onDelete: Restrict)
  receivedAt                DateTime              @default(now())
  verifiedByActorId         String?
  verifiedByActor           User?                 @relation("GrnVerifiedBy", fields: [verifiedByActorId], references: [id], onDelete: Restrict)
  verifiedAt                DateTime?
  signedOffByActorId        String?
  signedOffByActor          User?                 @relation("GrnSignedOffBy", fields: [signedOffByActorId], references: [id], onDelete: Restrict)
  signedOffAt               DateTime?
  finalizedByActorId        String?
  finalizedByActor          User?                 @relation("GrnFinalizedBy", fields: [finalizedByActorId], references: [id], onDelete: Restrict)
  finalizedAt               DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  lines                     GoodsReceiptLine[]
  documents                 GrnDocument[]
  stockLedgerEntries        StockLedgerEntry[]
  jobWorkReceiptReturn      JobWorkReceiptReturn?

  @@map("goods_receipt_notes")
}

model GoodsReceiptLine {
  id                 String                    @id @default(uuid())
  grnId              String
  grn                GoodsReceiptNote          @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId           String?
  poLine             PurchaseOrderLine?        @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  productId          String?
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  materialId         String?
  material           Material?                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uomId              String
  uom                UnitOfMeasure             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  expectedQuantity   Float?
  invoiceUnitPrice   Float?
  receivedQuantity   Float                     @default(0)
  acceptedQuantity   Float                     @default(0)
  rejectedQuantity   Float                     @default(0)
  damagedQuantity    Float                     @default(0)
  shortQuantity      Float                     @default(0)
  excessQuantity     Float                     @default(0)
  putAwayLocationId  String?
  lotId              String?
  lotNumber          String?
  lotManufacturedAt  DateTime?
  lotExpiresAt       DateTime?
  inventoryCondition InventoryCondition        @default(AVAILABLE)
  inventoryOwnership InventoryOwnership        @default(COMPANY)
  status             GrnLineStatus             @default(PENDING)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  measurements       GoodsReceiptMeasurement[]
  discrepancies      GoodsReceiptDiscrepancy[]
  label              GoodsReceiptLabel?
  stockLedgerEntry   StockLedgerEntry?
  inspectionResults  InspectionResult[]
  purchaseBillLines  PurchaseBillLine[]

  @@map("goods_receipt_lines")
}

// Append-only: a measurement row is never updated or deleted once written, including
// scale-retry attempts - the full measurement history stays on record for audit.
model GoodsReceiptMeasurement {
  id                String           @id @default(uuid())
  grnLineId         String
  grnLine           GoodsReceiptLine @relation(fields: [grnLineId], references: [id], onDelete: Cascade)
  measuredByActorId String
  measuredByActor   User             @relation("GrnMeasuredBy", fields: [measuredByActorId], references: [id], onDelete: Restrict)
  type              MeasurementType
  value             Float
  // Recorded exactly as read (e.g. "kg", "pcs") - no unit conversion is performed here.
  // V-013 (TO BE VALIDATED) blocks precise UOM/pack-size conversion tables.
  unitLabel         String
  note              String?
  recordedAt        DateTime         @default(now())

  @@map("goods_receipt_measurements")
}

model GoodsReceiptDiscrepancy {
  id                      String                     @id @default(uuid())
  grnLineId               String
  grnLine                 GoodsReceiptLine           @relation(fields: [grnLineId], references: [id], onDelete: Cascade)
  type                    DiscrepancyType
  quantity                Float
  status                  DiscrepancyStatus          @default(PENDING)
  resolutionType          DiscrepancyResolutionType?
  // Required by Zod when resolutionType = ACCEPT_EXCESS.
  acceptanceJustification String?
  // Required by Zod when resolutionType = RETURN_TO_VENDOR.
  returnReference         String?
  resolvedByActorId       String?
  resolvedByActor         User?                      @relation("GrnDiscrepancyResolvedBy", fields: [resolvedByActorId], references: [id], onDelete: Restrict)
  resolvedAt              DateTime?
  // See DebitNoteStatus note above (V-008): status/notes only, never a computed amount.
  debitNoteStatus         DebitNoteStatus?
  debitNoteNotes          String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  LossEvent               LossEvent?

  @@map("goods_receipt_discrepancies")
}

model GoodsReceiptLabel {
  id          String                        @id @default(uuid())
  grnLineId   String                        @unique
  grnLine     GoodsReceiptLine              @relation(fields: [grnLineId], references: [id], onDelete: Cascade)
  labelCode   String                        @unique
  generatedAt DateTime                      @default(now())
  printEvents GoodsReceiptLabelPrintEvent[]

  @@map("goods_receipt_labels")
}

// A reprint creates a new event row; the label's identity (labelCode) never changes.
model GoodsReceiptLabelPrintEvent {
  id               String            @id @default(uuid())
  labelId          String
  label            GoodsReceiptLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  printedByActorId String
  printedByActor   User              @relation("GrnLabelPrintedBy", fields: [printedByActorId], references: [id], onDelete: Restrict)
  printedAt        DateTime          @default(now())
  reason           String?

  @@map("goods_receipt_label_print_events")
}

model GrnDocument {
  id             String             @id @default(uuid())
  grnId          String
  grn            GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String
  documentType   String             @default("RECEIPT")
  sha256         String?
  pageCount      Int?
  uploadedBy     String
  uploader       User               @relation("GrnDocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  extractionJobs OcrExtractionJob[]

  @@map("grn_documents")
}

enum StockLedgerEntryType {
  GRN_RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  RETURN_TO_VENDOR
  REVERSAL
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
}

// Minimal inventory posting reference: one row per finalized GRN line with accepted
// quantity > 0. Not a full Inventory module (no stock-on-hand/valuation) - Module 4
// remains out of scope. @@unique(grnLineId) guarantees exactly one inventory effect
// per GRN line, matching the Module 3 Definition of Done.
model StockLedgerEntry {
  id                  String               @id @default(uuid())
  grnId               String?
  grnLineId           String?              @unique
  productId           String?
  materialId          String?
  uomId               String
  locationId          String?
  quantity            Float
  entryType           StockLedgerEntryType @default(GRN_RECEIPT)
  postedByActorId     String
  postedAt            DateTime             @default(now())
  adjustmentId        String?
  direction           StockDirection       @default(IN)
  issueId             String?
  note                String?
  ownership           StockOwnership       @default(OWNED)
  reversalOfId        String?
  transferId          String?
  materialIssueLineId String?              @unique
  materialIssueLine   MaterialIssueLine?   @relation(fields: [materialIssueLineId], references: [id])
  adjustment          StockAdjustment?     @relation(fields: [adjustmentId], references: [id])
  grn                 GoodsReceiptNote?    @relation(fields: [grnId], references: [id], onDelete: Restrict)
  grnLine             GoodsReceiptLine?    @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  issue               StockIssue?          @relation(fields: [issueId], references: [id])
  location            WarehouseLocation?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material            Material?            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  postedByActor       User                 @relation("StockLedgerPostedBy", fields: [postedByActorId], references: [id], onDelete: Restrict)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  reversalOf          StockLedgerEntry?    @relation("StockLedgerReversal", fields: [reversalOfId], references: [id])
  reversals           StockLedgerEntry[]   @relation("StockLedgerReversal")
  transfer            StockTransfer?       @relation(fields: [transferId], references: [id])
  uom                 UnitOfMeasure        @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([materialId])
  @@index([locationId])
  @@index([entryType])
  @@map("stock_ledger_entries")
}

