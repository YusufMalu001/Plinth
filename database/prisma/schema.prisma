enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  PO_CREATED
  CANCELLED
}

enum PoStatus {
  DRAFT
  APPROVED
  REJECTED
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
  SUPERSEDED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum PrApprovalStage {
  DRAFT
  STORE_REVIEW
  ADMIN_REVIEW
  COMPLETED
  RETURNED
}

enum ProcurementPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  WORKFLOW
  APPROVAL_REQUIRED
  APPROVED
  CHANGES_REQUESTED
  INFO
}

enum ExpectedReceiptStatus {
  PENDING
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

// ==============================================================================
// MODULE 2 - PROCUREMENT MODELS
// ==============================================================================

model PurchaseRequisition {
  id                    String                    @id @default(uuid())
  prNumber              String                    @unique
  requesterId           String
  requester             User                      @relation("PrRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  departmentId          String
  department            Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  preferredVendorId     String?
  preferredVendor       Vendor?                   @relation(fields: [preferredVendorId], references: [id], onDelete: Restrict)
  needDate              DateTime
  status                PrStatus                  @default(DRAFT)
  approvalStage         PrApprovalStage           @default(DRAFT)
  priority              ProcurementPriority       @default(NORMAL)
  businessJustification String?
  deliveryLocation      String?
  costCenter            String?
  projectCode           String?
  requestedBudget       Decimal?                  @db.Decimal(18, 2)
  notes                 String?
  createdAt             DateTime                  @default(now())
  submittedAt           DateTime?
  approvedAt            DateTime?
  updatedAt             DateTime                  @updatedAt
  lines                 PurchaseRequisitionLine[]
  purchaseOrders        PurchaseOrder[]
  approvals             ProcurementApproval[]     @relation("PrApprovals")
  documents             ProcurementDocument[]     @relation("PrDocuments")

  @@index([status, updatedAt])
  @@index([requesterId, createdAt])
  @@index([preferredVendorId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                  String              @id @default(uuid())
  prId                String
  purchaseRequisition PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  materialId          String?
  material            Material?           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uomId               String
  uom                 UnitOfMeasure       @relation(fields: [uomId], references: [id], onDelete: Restrict)
  requestedQuantity   Float
  estimatedUnitCost   Decimal?            @db.Decimal(18, 2)
  specifications      String?
  preferredMake       String?
  needDateOverride    DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("purchase_requisition_lines")
}

// Immutable snapshots make every submitted/change-requested PR revision auditable
// without changing the stable PR identifier used by downstream documents.
model PurchaseRequisitionRevision {
  id             String    @id @default(uuid())
  prId           String
  revisionNumber Int
  snapshot       Json
  createdBy      String
  createdAt      DateTime  @default(now())
  submittedAt    DateTime?
  isLocked       Boolean   @default(false)

  @@unique([prId, revisionNumber])
  @@index([prId, createdAt])
  @@map("purchase_requisition_revisions")
}

model PurchaseOrder {
  id                 String                @id @default(uuid())
  // TO BE VALIDATED: Default sequential numbering scheme. Confirm with Plinth if structured code like PO-YYYY-MM-SEQ is needed.
  poNumber           String
  vendorId           String
  vendor             Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  prId               String?
  sourcePr           PurchaseRequisition?  @relation(fields: [prId], references: [id], onDelete: SetNull)
  status             PoStatus              @default(DRAFT)
  revisionNumber     Int                   @default(1)
  currency           String                @default("INR")
  paymentTerms       String?
  deliveryLocation   String?
  dispatchedThrough String?
  otherReferences    String?
  termsOfDelivery    String?
  subtotal           Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal               @default(0) @db.Decimal(18, 2)
  previousRevisionId String?               @unique
  previousRevision   PurchaseOrder?        @relation("PoRevisionHistory", fields: [previousRevisionId], references: [id])
  nextRevision       PurchaseOrder?        @relation("PoRevisionHistory")
  createdAt          DateTime              @default(now())
  approvedAt         DateTime?
  sentAt             DateTime?
  updatedAt          DateTime              @updatedAt
  lines              PurchaseOrderLine[]
  approvals          ProcurementApproval[] @relation("PoApprovals")
  transmissions      TransmissionLog[]
  emailDeliveries    PurchaseOrderEmailDelivery[]
  documents          ProcurementDocument[] @relation("PoDocuments")
  goodsReceiptNotes  GoodsReceiptNote[]
  jobWorkOrders      JobWorkOrder[]

  @@unique([poNumber, revisionNumber])
  @@index([status, updatedAt])
  @@index([vendorId, createdAt])
  @@index([prId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String             @id @default(uuid())
  poId              String
  purchaseOrder     PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  materialId        String?
  material          Material?          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uomId             String
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id], onDelete: Restrict)
  quantity          Float
  unitPrice         Decimal            @default(0) @db.Decimal(18, 2)
  taxRate           Decimal            @default(0) @db.Decimal(5, 2)
  lineTotal         Decimal            @default(0) @db.Decimal(18, 2)
  needDate          DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  expectedReceipts  ExpectedReceipt[]
  goodsReceiptLines GoodsReceiptLine[]
  purchaseBillLines PurchaseBillLine[]

  @@map("purchase_order_lines")
}

model ProcurementApproval {
  id        String               @id @default(uuid())
  prId      String?
  pr        PurchaseRequisition? @relation("PrApprovals", fields: [prId], references: [id], onDelete: Cascade)
  poId      String?
  po        PurchaseOrder?       @relation("PoApprovals", fields: [poId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User                 @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
