  @@map("transmission_logs")
}

model PurchaseOrderEmailDelivery {
  id             String        @id @default(uuid())
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  revisionNumber Int
  attempt        Int            @default(1)
  recipient      String
  subject        String
  status         String         @default("SENDING")
  messageId      String?
  error          String?
