// ==============================================================================
// MODULE 5 - BILL OF MATERIALS (BOM) & FORMULA ENGINE
// ==============================================================================

enum BomStatus {
  DRAFT
  VALIDATION_PENDING
  APPROVED
  SUPERSEDED
  RETIRED
}

enum BomLineType {
  COMPONENT
  PACKAGING
}

enum BomQuantityMode {
  FIXED
  SCALED
}

enum BomRoundingRule {
  NONE
  ROUND_UP
  ROUND_DOWN
  ROUND_NEAREST
}

model BomVersion {
  id                 String             @id @default(uuid())
  // A BOM name identifies a formula within its parent item. Later versions reuse it.
  bomNumber          String
  productId          String?
  product            Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  materialId         String?
  material           Material?          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  productVariantId   String?
  productVariant     ProductVariant?    @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  // Detaching preserves the BOM record/history while removing it from the
  // parent's active item configuration. Existing plans retain their BOM FK.
  detachedFromItemAt DateTime?
  variantScopeKey    String
  version            Int
  status             BomStatus          @default(DRAFT)
  effectiveDate      DateTime?
  supersededById     String?            @unique
  supersededBy       BomVersion?        @relation("BomVersionSupersession", fields: [supersededById], references: [id])
  supersedes         BomVersion?        @relation("BomVersionSupersession")
  note               String?
  createdByActorId   String
  createdBy          User               @relation("BomCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  submittedByActorId String?
  submittedBy        User?              @relation("BomSubmittedBy", fields: [submittedByActorId], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  validatedByActorId String?
  validatedBy        User?              @relation("BomValidatedBy", fields: [validatedByActorId], references: [id], onDelete: SetNull)
  validatedAt        DateTime?
  approvedByActorId  String?
  approvedBy         User?              @relation("BomApprovedBy", fields: [approvedByActorId], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  retiredByActorId   String?
  retiredBy          User?              @relation("BomRetiredBy", fields: [retiredByActorId], references: [id], onDelete: SetNull)
  retiredAt          DateTime?
  lines              BomLine[]
  goldenExamples     BomGoldenExample[]
  simulationRuns     BomSimulationRun[]
  productionPlans    ProductionPlan[]
  productionRoutes   ProductRoute[] @relation("RouteBomVersion")
  materialIssues     MaterialIssue[]
  assemblyBatches    AssemblyBatch[]

  @@unique([productId, variantScopeKey, version])
  @@unique([materialId, variantScopeKey, version])
  @@index([detachedFromItemAt])
  @@map("bom_versions")
}

model BomLine {
  id                      String                      @id @default(uuid())
  bomVersionId            String
  bomVersion              BomVersion                  @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  lineType                BomLineType
  materialId              String?
  material                Material?                   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  componentProductId      String?
  componentProduct        Product?                    @relation("BomLineComponentProduct", fields: [componentProductId], references: [id], onDelete: SetNull)
  uomId                   String
  uom                     UnitOfMeasure               @relation(fields: [uomId], references: [id], onDelete: Restrict)
  quantityMode            BomQuantityMode
  quantity                Decimal                     @db.Decimal(18, 6)
  unitCost                Decimal?                    @db.Decimal(18, 4)
  roundingRule            BomRoundingRule             @default(NONE)
  roundingPrecision       Int?
  departmentId            String?
  department              Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sequence                Int                         @default(0)
  note                    String?
  productionRequirements  ProductionPlanRequirement[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  materialIssueLines      MaterialIssueLine[]
  assemblyBatchComponents AssemblyBatchComponent[]
  routeMaterialAllocations RouteMaterialAllocation[]
  taskMaterialAssignments ProductionTaskMaterialAssignment[]
  assemblyIntakeRequirements AssemblyIntakeRequirement[]

  @@index([bomVersionId])
  @@map("bom_lines")
}

model BomGoldenExample {
  id               String        @id @default(uuid())
  bomVersionId     String
  bomVersion       BomVersion    @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  label            String
  inputQuantity    Decimal       @db.Decimal(18, 6)
  inputUomId       String
  inputUom         UnitOfMeasure @relation(fields: [inputUomId], references: [id], onDelete: Restrict)
  expectedResults  Json
  sourceReference  String?
  createdByActorId String
  createdBy        User          @relation("BomGoldenExampleCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())

  @@index([bomVersionId])
  @@map("bom_golden_examples")
}

model BomSimulationRun {
  id                String        @id @default(uuid())
  bomVersionId      String
  bomVersion        BomVersion    @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  bomVersionNumber  Int
  requestedQuantity Decimal       @db.Decimal(18, 6)
  requestedUomId    String
  requestedUom      UnitOfMeasure @relation(fields: [requestedUomId], references: [id], onDelete: Restrict)
  isAuthoritative   Boolean
  resultBreakdown   Json
  matchesGolden     Boolean?
  runByActorId      String
  runBy             User          @relation("BomSimulationRunBy", fields: [runByActorId], references: [id], onDelete: Restrict)
  runAt             DateTime      @default(now())

  @@index([bomVersionId])
  @@map("bom_simulation_runs")
}

// ==============================================================================
// MODULE 6 - PRODUCTION PLANNING & SCHEDULING
// ==============================================================================

enum ProductionPlanStatus {
  DRAFT
  CHECKED
  PENDING_APPROVAL
  APPROVED
  RELEASED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  INTERRUPTED
  CANCELLED
}

enum ProductionPlanEventType {
  CREATED
  UPDATED
  CHECKED
  SUBMITTED
  APPROVED
  RELEASED
  STARTED
  PARTIAL_COMPLETION
  COMPLETED
  INTERRUPTED
  CANCELLED
  MODIFIED
  CARRY_FORWARD_CREATED
}

model ProductionPlan {
  id                   String                      @id @default(uuid())
  planNumber           String                      @unique
  scheduleDate         DateTime
  productId            String
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  bomVersionId         String
  bomVersion           BomVersion                  @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  routeId              String?
  route                ProductRoute?               @relation(fields: [routeId], references: [id], onDelete: SetNull)
  ownerId              String?
  owner                User?                       @relation("ProductionPlanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  groupKey             String?
  scheduleType         String
  quantity             Decimal                     @db.Decimal(18, 6)
  quantityUomId        String?
  quantityUom          UnitOfMeasure?              @relation("ProductionPlanQuantityUom", fields: [quantityUomId], references: [id], onDelete: Restrict)
  bufferQuantity       Decimal                     @default(0) @db.Decimal(18, 6)
  priority             Int                         @default(0)
  incharge             String?
  notes                String?
  targetDepartmentId   String?
  targetLocationId     String?
  targetLocation       WarehouseLocation?          @relation("ProductionPlanTargetLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)
  sourceReferenceType  String?
  sourceReferenceId    String?
  plannedStartAt       DateTime?
  plannedEndAt         DateTime?
  status               ProductionPlanStatus        @default(PENDING_APPROVAL)
  approvedShortageAck  Boolean                     @default(false)
  materialSnapshot     Json?
  requirementSnapshot  Json?
  interruptionReason   String?
  partialQuantity      Decimal?                    @db.Decimal(18, 6)
  completedQuantity    Decimal?                    @db.Decimal(18, 6)
  carryForwardFromId   String?
  carryForwardFrom     ProductionPlan?             @relation("CarryForward", fields: [carryForwardFromId], references: [id], onDelete: SetNull)
  carryForwardTo       ProductionPlan[]            @relation("CarryForward")
  carryForwardToId     String?                     @unique
  batchIdentity        String?                     @unique
  releasedAt           DateTime?
  inProgressAt         DateTime?
  completedAt          DateTime?
  interruptedAt        DateTime?
  cancelledAt          DateTime?
  createdByActorId     String
  createdByActor       User                        @relation("ProductionPlanCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  checkedByActorId     String?
  checkedByActor       User?                       @relation("ProductionPlanCheckedBy", fields: [checkedByActorId], references: [id], onDelete: SetNull)
  submittedByActorId   String?
  submittedByActor     User?                       @relation("ProductionPlanSubmittedBy", fields: [submittedByActorId], references: [id], onDelete: SetNull)
  approvedByActorId    String?
  approvedByActor      User?                       @relation("ProductionPlanApprovedBy", fields: [approvedByActorId], references: [id], onDelete: SetNull)
  releasedByActorId    String?
  releasedByActor      User?                       @relation("ProductionPlanReleasedBy", fields: [releasedByActorId], references: [id], onDelete: SetNull)
  cancelledByActorId   String?
  cancelledByActor     User?                       @relation("ProductionPlanCancelledBy", fields: [cancelledByActorId], references: [id], onDelete: SetNull)
  modifiedByActorId    String?
  modifiedByActor      User?                       @relation("ProductionPlanModifiedBy", fields: [modifiedByActorId], references: [id], onDelete: SetNull)
  interruptedByActorId String?
  interruptedByActor   User?                       @relation("ProductionPlanInterruptedBy", fields: [interruptedByActorId], references: [id], onDelete: SetNull)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  events               ProductionPlanEvent[]
  requirements         ProductionPlanRequirement[]
  materialIssues       ProductionMaterialIssue[]
  materialIssueRecords MaterialIssue[]
  outputs              ProductionOutput[]
  batches              DepartmentExecutionBatch[]
  assemblyBatches      AssemblyBatch[]
  taskMaterialAssignments ProductionTaskMaterialAssignment[]
  assemblyIntakeRequirements AssemblyIntakeRequirement[]

  @@index([scheduleDate, productId, scheduleType])
  @@index([scheduleDate, status])
  @@map("production_plans")
}

model ProductionPlanEvent {
  id               String                  @id @default(uuid())
  productionPlanId String
  productionPlan   ProductionPlan          @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  eventType        ProductionPlanEventType
  fromStatus       ProductionPlanStatus?
  toStatus         ProductionPlanStatus?
  reason           String?
  payload          Json?
  actorId          String
  actor            User                    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())

  @@index([productionPlanId, createdAt])
  @@map("production_plan_events")
}

model ProductionPlanRequirement {
  id                String         @id @default(uuid())
  productionPlanId  String
  productionPlan    ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  bomLineId         String?
  bomLine           BomLine?       @relation(fields: [bomLineId], references: [id], onDelete: SetNull)
  itemType          String
  itemId            String
  requiredUomId     String
  requiredUom       UnitOfMeasure  @relation("ProductionRequirementUom", fields: [requiredUomId], references: [id], onDelete: Restrict)
  requiredQuantity  Decimal        @db.Decimal(18, 6)
  inventoryUomId    String
  inventoryUom      UnitOfMeasure  @relation("ProductionRequirementInventoryUom", fields: [inventoryUomId], references: [id], onDelete: Restrict)
  inventoryQuantity Decimal        @db.Decimal(18, 6)
  reservedQuantity  Decimal        @default(0) @db.Decimal(18, 6)
  issuedQuantity    Decimal        @default(0) @db.Decimal(18, 6)
  shortageQuantity  Decimal        @default(0) @db.Decimal(18, 6)
  locationId        String
  lotStrategy       String         @default("FIFO")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([productionPlanId, itemType, itemId])
  @@map("production_plan_requirements")
}

model ProductionMaterialIssue {
  id                     String                     @id @default(uuid())
  issueNumber            String                     @unique
  productionPlanId       String
  productionPlan         ProductionPlan             @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)
  idempotencyKey         String?                    @unique
  itemType               String
  itemId                 String
  uomId                  String
  uom                    UnitOfMeasure              @relation("ProductionIssueUom", fields: [uomId], references: [id], onDelete: Restrict)
  locationId             String
  lotId                  String?
  quantity               Decimal                    @db.Decimal(18, 6)
  inventoryLedgerEntryId String?
  issuedByActorId        String
  issuedAt               DateTime                   @default(now())
  reversedAt             DateTime?
  reversalLedgerEntryId  String?
  reason                 String?
  departmentBatches      DepartmentExecutionBatch[]

  @@index([productionPlanId, issuedAt])
  @@map("production_material_issues")
}

model ProductionOutput {
  id                     String         @id @default(uuid())
  outputNumber           String         @unique
  productionPlanId       String
  productionPlan         ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)
  idempotencyKey         String?        @unique
  quantity               Decimal        @db.Decimal(18, 6)
  rejectedQuantity       Decimal        @default(0) @db.Decimal(18, 6)
  damagedQuantity        Decimal        @default(0) @db.Decimal(18, 6)
  uomId                  String
  uom                    UnitOfMeasure  @relation("ProductionOutputUom", fields: [uomId], references: [id], onDelete: Restrict)
  locationId             String
  lotId                  String?
  inventoryLedgerEntryId String?
  recordedByActorId      String
  recordedAt             DateTime       @default(now())
  note                   String?

  @@index([productionPlanId, recordedAt])
  @@map("production_outputs")
}

// ==============================================================================
// MODULE 8 - DEPARTMENT-WISE EXECUTION & SHOP-FLOOR TRACKING
// ==============================================================================

enum BatchExecutionStatus {
  AWAITING_RECEIPT
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  PAUSED
  PARTIAL
  COMPLETE
  REWORK
  REJECTED
  HANDOVER_PENDING
  NEXT_STAGE_ACCEPTED
  PENDING
  COMPLETED
  INTERRUPTED
  CANCELLED
}

enum ProgressEventType {
  STARTED
  PAUSED
  RESUMED
  PARTIAL_RECORDED
  COMPLETED
}

enum ExceptionRecordType {
  REJECTION
  SCRAP
  WASTAGE
  PENDING
  INTERRUPTION
}

enum HandoverStatus {
  PROPOSED
  ACCEPTED
  REFUSED
}

// Conservation invariant (enforced in service layer):
// received_qty = completed_qty + rejected_qty + scrap_qty + wastage_qty + pending_qty
model DepartmentExecutionBatch {
  id                  String                   @id @default(uuid())
  batchNumber         String                   @unique
  productionPlanId    String
  productionPlan      ProductionPlan           @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)
  materialIssueId     String?
  materialIssue       ProductionMaterialIssue? @relation(fields: [materialIssueId], references: [id], onDelete: SetNull)
  departmentId        String
  department          Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workCenterId        String?
  workCenter          WorkCenter?              @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  routeStepId         String?
  routeStep           RouteStep?               @relation(fields: [routeStepId], references: [id], onDelete: SetNull)
  stageSequenceNumber Int                      @default(1)
  expectedOutputQty   Decimal?                 @db.Decimal(18, 6)
  outputItemType      String?
  outputItemId        String?
  outputUomId         String?
  status              BatchExecutionStatus     @default(AWAITING_RECEIPT)

  received_qty  Decimal @default(0) @db.Decimal(18, 6)
  completed_qty Decimal @default(0) @db.Decimal(18, 6)
  rejected_qty  Decimal @default(0) @db.Decimal(18, 6)
  scrap_qty     Decimal @default(0) @db.Decimal(18, 6)
  wastage_qty   Decimal @default(0) @db.Decimal(18, 6)
  pending_qty   Decimal @default(0) @db.Decimal(18, 6)

  notes            String?
  sourceHandoverId String?   @unique
  sourceHandover   Handover? @relation("HandoverCreatedBatch", fields: [sourceHandoverId], references: [id], onDelete: SetNull)

  workerAssignments        WorkerAssignment[]
  progressEvents           ProgressEvent[]
  exceptionRecords         ExceptionRecord[]
  outgoingHandovers        Handover[]                   @relation("OutgoingBatchHandovers")
  incomingHandovers        Handover[]                   @relation("IncomingBatchHandovers")
  materialAssignments      ProductionTaskMaterialAssignment[]
  reconciliationExceptions WipReconciliationException[]
  inspectionResults        InspectionResult[]
  assemblyComponents       AssemblyBatchComponent[]     @relation("AssemblySourceBatch")

  createdByActorId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productionPlanId, status])
  @@index([departmentId, status])
  @@map("department_execution_batches")
}

model WorkerAssignment {
