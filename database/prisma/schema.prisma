}

enum ScoreConfidenceStatus {
  SUFFICIENT_EVIDENCE
  PROVISIONAL
  INSUFFICIENT_DATA
  NOT_APPLICABLE
}

enum EmployeeGoalStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  PARTIALLY_ACHIEVED
  MISSED
  CANCELLED
}

model EmployeeScoringPolicy {
  id                      String                  @id @default(uuid())
  version                 Int                     @default(1)
  name                    String                  @default("DEFAULT")
  weights                 Json                    // { taskOutcomes: 30, quality: 25, delivery: 20, productivity: 10, roleGoals: 10, attendance: 5 }
  rollingWindowDays       Int                     @default(90)
  minEvidenceTasks        Int                     @default(3)
  minEvidenceAttendances  Int                     @default(10)
  provisionalPolicy       String                  @default("NEUTRAL_PRIOR") // "NEUTRAL_PRIOR" | "RENORMALIZE"
  provisionalNeutralScore Decimal                 @default(70.0) @db.Decimal(5, 2)
  status                  String                  @default("ACTIVE") // "ACTIVE" | "RETIRED"
  createdBy               String                  @default("SYSTEM")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  snapshots               EmployeeScoreSnapshot[]

  @@unique([name, version])
  @@map("employee_scoring_policies")
}

model EmployeeScoreSnapshot {
  id                  String                @id @default(uuid())
  employeeId          String
  employee            Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId            String?
  policy              EmployeeScoringPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyVersion       Int                   @default(1)
  overallScore        Decimal               @db.Decimal(5, 2)
  grade               String                // "A+" | "A" | "B" | "C" | "D"
  confidenceStatus    ScoreConfidenceStatus @default(SUFFICIENT_EVIDENCE)
  velocityRating      String                // "FAST" | "OPTIMAL" | "MODERATE" | "SLOW"
  taskOutcomeScore    Decimal               @db.Decimal(5, 2)
  qualityScore        Decimal               @db.Decimal(5, 2)
  deliveryScore       Decimal               @db.Decimal(5, 2)
  productivityScore   Decimal               @db.Decimal(5, 2)
  roleGoalScore       Decimal               @db.Decimal(5, 2)
  attendanceScore     Decimal               @db.Decimal(5, 2)
  componentBreakdown  Json                  // detailed metrics, observation counts, formula traces
  scoringPeriodStart  DateTime
  scoringPeriodEnd    DateTime
  calculatedAt        DateTime              @default(now())

  @@index([employeeId, calculatedAt])
  @@index([employeeId, scoringPeriodStart, scoringPeriodEnd])
  @@map("employee_score_snapshots")
}

model EmployeeGoal {
  id             String             @id @default(uuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  weight         Decimal            @default(1.0) @db.Decimal(5, 2)
  targetValue    Decimal            @default(100.0) @db.Decimal(10, 2)
  achievedValue  Decimal            @default(0.0) @db.Decimal(10, 2)
  unit           String             @default("%")
  status         EmployeeGoalStatus @default(IN_PROGRESS)
  startDate      DateTime
  targetDate     DateTime
  achievedAt     DateTime?
  approvedBy     String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([employeeId, status, targetDate])
  @@map("employee_goals")
}

model SalesChannel {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  description   String?
  currency      String          @default("INR")
  status        LifecycleStatus @default(DRAFT)
  deactivatedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("sales_channels")
}

// ==============================================================================
// MODULE 1 - ORGANIZATIONAL STRUCTURE
