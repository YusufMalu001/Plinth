  @@map("corrective_actions")
}

// ==============================================================================
// MODULE 11 - LOSS, DAMAGE & WASTE MANAGEMENT
// ==============================================================================

enum LossSourceType {
  DEPARTMENT_EXECUTION_EXCEPTION
  GRN_DISCREPANCY
  QC_REJECTION_NO_BATCH
  MANUAL_REPORT
}

enum LossClassification {
  WITHIN_TOLERANCE
  ABNORMAL
}

enum LossEventStatus {
  REPORTED
  REVIEWED
  APPROVED
  REJECTED
  INVESTIGATED
  POSTED
  REPLACED
}

model LossEvent {
  id                        String              @id @default(uuid())
  lossNumber                String              @unique
  sourceType                LossSourceType
  sourceExceptionRecordId   String?             @unique
  sourceDiscrepancyId       String?             @unique
  sourceInspectionResultId  String?             @unique
  materialId                String?
  productId                 String?
  uomId                     String
  locationId                String?
  departmentId              String?
  quantity                  Decimal             @db.Decimal(18, 6)
  reason                    String
  reportedByActorId         String
  reportedAt                DateTime            @default(now())
  appliedWastageRuleId      String?
  appliedWastageRuleVersion Int?
  varianceFromExpected      Decimal?            @db.Decimal(18, 6)
  classification            LossClassification?
  status                    LossEventStatus     @default(REPORTED)
  reviewedByActorId         String?
  reviewedAt                DateTime?
  reviewNotes               String?
  approvedByActorId         String?
  approvedAt                DateTime?
  rejectedByActorId         String?
  rejectedAt                DateTime?
  rejectionReason           String?
  investigatedByActorId     String?
  investigatedAt            DateTime?
  investigationNotes        String?
  stockEffectRef            String?
  replacementChallanRef     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  reportedByActor        User                     @relation("LossEventReportedBy", fields: [reportedByActorId], references: [id], onDelete: Restrict)
  reviewedByActor        User?                    @relation("LossEventReviewedBy", fields: [reviewedByActorId], references: [id], onDelete: SetNull)
  approvedByActor        User?                    @relation("LossEventApprovedBy", fields: [approvedByActorId], references: [id], onDelete: SetNull)
  rejectedByActor        User?                    @relation("LossEventRejectedBy", fields: [rejectedByActorId], references: [id], onDelete: SetNull)
  investigatedByActor    User?                    @relation("LossEventInvestigatedBy", fields: [investigatedByActorId], references: [id], onDelete: SetNull)
  material               Material?                @relation(fields: [materialId], references: [id], onDelete: SetNull)
  product                Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  uom                    UnitOfMeasure            @relation(fields: [uomId], references: [id], onDelete: Restrict)
  location               WarehouseLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department             Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sourceExceptionRecord  ExceptionRecord?         @relation(fields: [sourceExceptionRecordId], references: [id], onDelete: SetNull)
  sourceDiscrepancy      GoodsReceiptDiscrepancy? @relation(fields: [sourceDiscrepancyId], references: [id], onDelete: SetNull)
  sourceInspectionResult InspectionResult?        @relation(fields: [sourceInspectionResultId], references: [id], onDelete: SetNull)
  appliedWastageRule     WastageRule?             @relation(fields: [appliedWastageRuleId], references: [id], onDelete: SetNull)
  replacementChallan     ReplacementChallan?

  @@index([sourceType, status])
  @@index([materialId])
  @@index([productId])
  @@index([locationId])
  @@index([departmentId])
  @@index([classification])
  @@map("loss_events")
}

model ReplacementChallan {
  id                    String    @id @default(uuid())
  challanNumber         String    @unique
  lossEventId           String    @unique
  materialId            String?
  productId             String?
  uomId                 String
  quantity              Decimal   @db.Decimal(18, 6)
  dispatchLocationId    String
  targetDepartmentId    String?
  targetVendorId        String?
  notes                 String?
  issuedByActorId       String
  issuedAt              DateTime  @default(now())
  acknowledgedByActorId String?
  acknowledgedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lossEvent           LossEvent         @relation(fields: [lossEventId], references: [id], onDelete: Cascade)
  material            Material?         @relation(fields: [materialId], references: [id], onDelete: SetNull)
  product             Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  uom                 UnitOfMeasure     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  dispatchLocation    WarehouseLocation @relation(fields: [dispatchLocationId], references: [id], onDelete: Restrict)
  targetDepartment    Department?       @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  targetVendor        Vendor?           @relation(fields: [targetVendorId], references: [id], onDelete: SetNull)
  issuedByActor       User              @relation("ReplacementChallanIssuedBy", fields: [issuedByActorId], references: [id], onDelete: Restrict)
  acknowledgedByActor User?             @relation("ReplacementChallanAcknowledgedBy", fields: [acknowledgedByActorId], references: [id], onDelete: SetNull)

  @@index([lossEventId])
  @@index([dispatchLocationId])
  @@map("replacement_challans")
}

// ==============================================================================
// MODULE 12 - ASSEMBLY EXECUTION & CONVERGENCE ENGINE
// ==============================================================================

enum AssemblyBatchStatus {
  PLANNED
  ALLOCATED
  IN_ASSEMBLY
  PARTIAL
  COMPLETE
  QC_PENDING
  PASSED_TO_FG
  REWORK
  REJECTED
}

enum AssemblyComponentType {
  BATCH_SOURCED
  ISSUE_LINE_SOURCED
}

model AssemblyBatch {
  id                   String              @id @default(uuid())
  batchNumber          String              @unique
  productId            String
  product              Product             @relation("AssemblyProduct", fields: [productId], references: [id], onDelete: Restrict)
  productVariantId     String?
  productVariant       ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productionPlanId     String?
  productionPlan       ProductionPlan?     @relation(fields: [productionPlanId], references: [id], onDelete: SetNull)
  bomVersionId         String
  bomVersion           BomVersion          @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  productRouteId       String?
  productRoute         ProductRoute?       @relation(fields: [productRouteId], references: [id], onDelete: SetNull)
  targetOutputQuantity Decimal             @db.Decimal(18, 6)
  actualOutputQuantity Decimal             @default(0) @db.Decimal(18, 6)
  scrapQuantity        Decimal             @default(0) @db.Decimal(18, 6)
  status               AssemblyBatchStatus @default(PLANNED)
  plannedStartDate     DateTime?
  actualStartDate      DateTime?
  completedAt          DateTime?
  idempotencyKey       String?             @unique
  allocationIdempotencyKey String?         @unique
  notes                String?
  reworkCount          Int                 @default(0)
  createdByActorId     String
  createdByActor       User                @relation("AssemblyBatchCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  allocatedByActorId   String?
  allocatedByActor     User?               @relation("AssemblyBatchAllocatedBy", fields: [allocatedByActorId], references: [id], onDelete: SetNull)
  completedByActorId   String?
  completedByActor     User?               @relation("AssemblyBatchCompletedBy", fields: [completedByActorId], references: [id], onDelete: SetNull)
  qcInspectionResultId String?
  qcInspectionResult   InspectionResult?   @relation("AssemblyBatchInspectionResult", fields: [qcInspectionResultId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  components        AssemblyBatchComponent[]
  intakeAllocations AssemblyWaveIntakeAllocation[]
  workerAssignments AssemblyWorkerAssignment[]
  progressEvents    AssemblyProgressEvent[]
  fgReadyOutputs    FgReadyOutput[]

  @@index([productId, status])
  @@index([productionPlanId])
  @@index([status])
  @@map("assembly_batches")
}

model AssemblyBatchComponent {
  id                  String                    @id @default(uuid())
  assemblyBatchId     String
  assemblyBatch       AssemblyBatch             @relation(fields: [assemblyBatchId], references: [id], onDelete: Cascade)
  bomLineId           String?
  bomLine             BomLine?                  @relation(fields: [bomLineId], references: [id], onDelete: SetNull)
  componentType       AssemblyComponentType
  sourceBatchId       String?
  sourceBatch         DepartmentExecutionBatch? @relation("AssemblySourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  materialIssueLineId String?
  materialIssueLine   MaterialIssueLine?        @relation(fields: [materialIssueLineId], references: [id], onDelete: Restrict)
  uomId               String
  uom                 UnitOfMeasure             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  unitRatio           Decimal                   @db.Decimal(18, 6)
  requiredQuantity    Decimal                   @db.Decimal(18, 6)
  consumedQuantity    Decimal                   @default(0) @db.Decimal(18, 6)
  scrapQuantity       Decimal                   @default(0) @db.Decimal(18, 6)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([assemblyBatchId])
  @@index([sourceBatchId])
  @@index([materialIssueLineId])
  @@map("assembly_batch_components")
}

model AssemblyWorkerAssignment {
  id                 String        @id @default(uuid())
  assemblyBatchId    String
  assemblyBatch      AssemblyBatch @relation(fields: [assemblyBatchId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation("AssemblyWorkerEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  subtaskDescription String?
  assignedByActorId  String
  assignedByActor    User          @relation("AssemblyWorkerAssignedBy", fields: [assignedByActorId], references: [id], onDelete: Restrict)
  assignedAt         DateTime      @default(now())

  @@index([assemblyBatchId, employeeId])
  @@map("assembly_worker_assignments")
}

model AssemblyProgressEvent {
  id              String            @id @default(uuid())
  assemblyBatchId String
  assemblyBatch   AssemblyBatch     @relation(fields: [assemblyBatchId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee          @relation("AssemblyProgressEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  eventType       ProgressEventType
  quantityDelta   Decimal           @default(0) @db.Decimal(18, 6)
  notes           String?
  timestamp       DateTime          @default(now())

  @@index([assemblyBatchId, timestamp])
  @@map("assembly_progress_events")
}

// ==============================================================================
// MODULE 13 - FINISHED GOODS (FG) RECEIVING & GATE INTEGRATION
// ==============================================================================

// Configurable packaging readiness status set.
// ASSUMPTION: Default status set pending final operational confirmation from Plinth.
enum FgPackagingStatus {
  NOT_PACKED
  PACKED
  READY_FOR_DISPATCH
}

enum FgReceiptStatus {
  RECEIVED
  HELD
  RELEASED
  CANCELLED
}

// Pre-FG intermediate state: Physically produced output that is NOT yet received
// into postable StockBalance / StockLedgerEntry.
model FgReadyOutput {
  id                   String            @id @default(uuid())
  outputNumber         String            @unique
  assemblyBatchId      String?           @unique
  assemblyBatch        AssemblyBatch?    @relation(fields: [assemblyBatchId], references: [id], onDelete: Restrict)
  productId            String
  product              Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariantId     String?
  productVariant       ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  quantity             Decimal           @db.Decimal(18, 6)
  uomId                String
  uom                  UnitOfMeasure     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  qcInspectionResultId String?
  qcInspectionResult   InspectionResult? @relation("FgReadyOutputInspectionResult", fields: [qcInspectionResultId], references: [id], onDelete: SetNull)
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  packagingRecord FgPackagingRecord?
  fgReceipt       FgReceipt?

  @@index([productId])
  @@map("fg_ready_outputs")
}

model FgPackagingRecord {
  id               String             @id @default(uuid())
  fgReadyOutputId  String             @unique
  fgReadyOutput    FgReadyOutput      @relation(fields: [fgReadyOutputId], references: [id], onDelete: Cascade)
  status           FgPackagingStatus  @default(NOT_PACKED)
  packNotes        String?
  stagedLocationId String?
  stagedLocation   WarehouseLocation? @relation(fields: [stagedLocationId], references: [id], onDelete: SetNull)
  updatedByActorId String
  updatedByActor   User               @relation("FgPackagingUpdatedBy", fields: [updatedByActorId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@map("fg_packaging_records")
}

model FgReceipt {
  id                String            @id @default(uuid())
  receiptNumber     String            @unique
  fgReadyOutputId   String            @unique
  fgReadyOutput     FgReadyOutput     @relation(fields: [fgReadyOutputId], references: [id], onDelete: Restrict)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariantId  String?
  productVariant    ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  locationId        String
  location          WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity          Float
  uomId             String
  uom               UnitOfMeasure     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  status            FgReceiptStatus   @default(RECEIVED)
  holdReason        String?
  heldAt            DateTime?
  heldByActorId     String?
  heldByActor       User?             @relation("FgReceiptHeldBy", fields: [heldByActorId], references: [id], onDelete: SetNull)
  releasedAt        DateTime?
  releasedByActorId String?
  releasedByActor   User?             @relation("FgReceiptReleasedBy", fields: [releasedByActorId], references: [id], onDelete: SetNull)
  receivedByActorId String
  receivedByActor   User              @relation("FgReceiptReceivedBy", fields: [receivedByActorId], references: [id], onDelete: Restrict)
  receivedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([productId, status])
  @@index([locationId])
  @@map("fg_receipts")
}

