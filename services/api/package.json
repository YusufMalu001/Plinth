{
  "name": "@plinth/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express Backend Modular Monolith for Plinth ERP",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run build --workspace=@plinth/validation",
    "dev": "ts-node-dev --respawn --transpile-only --watch ../../packages/validation/dist src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/intelligence-worker.js",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/intelligence-worker.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:purge-dummy-uoms": "node -e 'require(\"ts-node/register\"); require(\"../../database/prisma/seed/purge-dummy-uoms.ts\");'",
    "db:seed-hsn-sac": "node -e 'require(\"ts-node/register\"); require(\"../../database/prisma/seed/seed-hsn-sac-only.ts\");'",
    "db:verify-hsn-sac-db": "node -e 'require(\"ts-node/register\"); require(\"../../database/prisma/seed/verify-hsn-sac-database.ts\");'"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "@plinth/types": "*",
    "@plinth/validation": "*",
    "@types/ws": "^8.18.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "@plinth/tokens": "*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}