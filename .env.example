# .env.example — copy to ../.env and fill in.
# NOTE: some variables still carry legacy PLINTH_* names in code (Addendum #9 will
# rename them to plinth-*); both names are documented until that codemod lands.

# --- Database (Prisma, via database/package.json dotenv -e ../.env) -----------
DATABASE_URL=postgresql://plinth:plinth@localhost:5432/plinth_erp
DIRECT_URL=postgresql://plinth:plinth@localhost:5432/plinth_erp
TEST_DATABASE_URL=postgresql://plinth:plinth@localhost:5432/plinth_erp_test
TEST_DIRECT_URL=postgresql://plinth:plinth@localhost:5432/plinth_erp_test

# --- API server --------------------------------------------------------------
API_PORT=4000                    # legacy containers read PLINTH_API_PORT
JWT_SECRET=change-me-32-chars-minimum-0123456789abcdef
JWT_REFRESH_SECRET=change-me-32-chars-minimum-refresh-key-00000
COOKIE_SECURE=false
NODE_ENV=development

# --- First-party (Supabase) auth, optional ------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web (Next.js) ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000/api/v1
# deployment-specific overrides
NEXT_PUBLIC_STAGING_APP_URL=
NEXT_PUBLIC_STAGING_WEB_URL=
NEXT_PUBLIC_PRODUCTION_APP_URL=
NEXT_PUBLIC_PRODUCTION_WEB_URL=
NEXT_PUBLIC_VERCEL_ENV=

# --- Intelligence integrations (internal MCP runtime) --------------------------
PLINTH_MCP_TOKEN=               # legacy name PLINTH_MCP_TOKEN (docker compose / intelligence config)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LOG_DB_QUERIES=false
